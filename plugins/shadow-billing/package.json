{
  "name": "dsh-shadow-billing",
  "version": "0.1.0",
  "description": "DSH 本地模型影子计费：按 DeepSeek Flash 峰谷价 + 真实 token 用量折算估算费用（会话头部徽标 + 用量页签）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "MIT"
}
