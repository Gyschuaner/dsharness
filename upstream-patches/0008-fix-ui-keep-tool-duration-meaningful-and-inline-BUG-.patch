+async function inlineGap(text: Locator, timer: Locator): Promise<number> {
+  const textRight = await text.evaluate((element) => {
+    const range = document.createRange()
+    range.selectNodeContents(element)
+    return range.getBoundingClientRect().right
+  })
+  const timerLeft = await timer.evaluate(element => element.getBoundingClientRect().left)
+  return timerLeft - textRight
+}
