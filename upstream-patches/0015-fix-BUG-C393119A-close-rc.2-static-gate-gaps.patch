 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/core/agent-loop/src/malformed-tool-call.ts b/packages/core/agent-loop/src/malformed-tool-call.ts
index 79539a2..98ea326 100644
--- a/packages/core/agent-loop/src/malformed-tool-call.ts
+++ b/packages/core/agent-loop/src/malformed-tool-call.ts
@@ -4,7 +4,7 @@ import { createUserMessage } from '@deepseek-ai/dsh-llm'
 import type { UserMessage } from '@deepseek-ai/dsh-llm'
 
 /** Guidance retained immediately after a model wrote a would-be tool call in reasoning. */
-export const MALFORMED_TOOL_CALL_RETRY_REMINDER = `<system-reminder>
+const MALFORMED_TOOL_CALL_RETRY_REMINDER = `<system-reminder>
