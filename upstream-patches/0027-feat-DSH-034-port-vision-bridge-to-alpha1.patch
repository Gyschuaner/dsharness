+/* Dedicated visual Tool row. Geometry and activity motion intentionally match Think. */
+
+.root {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  min-width: 0;
+}
+
+/* This keyed row renders the activity counter beside Look, so the generic Tool counter is redundant. */
+.root + [data-tool-activity-state] {
+  display: none;
+}
+
+.leading {
+  flex-shrink: 0;
+}
+
+.chevron {
+  color: var(--dsw-alias-label-secondary);
+}
+
+.title {
+  font-weight: 400;
+}
+
+.activity {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  gap: 5px;
+  margin-left: 5px;
+  color: var(--dsw-alias-label-caption);
+  font-size: 14px;
+  line-height: 24px;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.timer {
+  min-width: 20px;
+}
+
+.separator {
+  flex: none;
+  width: 2px;
+  height: 2px;
+  margin: 0 8px;
+  border-radius: 1px;
+  background: var(--dsw-alias-label-caption);
+}
+
+.summary {
+  min-width: 0;
+  overflow: hidden;
+  flex: 1 1 auto;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 14px;
+  line-height: 24px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.summary[data-follow-end] {
+  text-overflow: clip;
+}
+
+.errorSummary {
+  color: var(--dsw-alias-state-error-primary);
+}
+
+.bodyWrap {
+  display: flex;
+  flex-direction: column;
+}
+
+.ioCard {
+  display: flex;
+  flex-direction: column;
+  max-height: 260px;
+  margin: 4px 0 4px 4px;
+  overflow: hidden;
+  border: 1px solid var(--dsw-alias-border-l1);
+  border-radius: 12px;
+  background: var(--dsw-alias-markdown-code-block);
+  font: var(--dsw-font-markdown-code-block-small);
+}
+
+.ioSection {
+  display: grid;
+  grid-template-columns: max-content minmax(0, 1fr);
+  column-gap: 14px;
+  align-items: baseline;
+  min-height: 0;
+  padding: 10px 12px;
+  overflow: auto;
+}
+
+.ioLabel {
+  color: var(--dsw-alias-label-caption);
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+}
+
+.ioText {
+  min-width: 0;
+  margin: 0;
+  color: var(--dsw-alias-label-secondary);
+  font: inherit;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.ioText[data-error] {
+  color: var(--dsw-alias-state-error-primary);
+}
+
+.ioDivider {
+  height: 1px;
+  background: var(--dsw-alias-border-l2);
+}
+
+.inspectButton {
+  display: inline-flex;
+  align-self: flex-start;
+  align-items: center;
+  gap: 4px;
+  margin: 4px 0 2px 4px;
+  padding: 2px 8px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 999px;
+  background: var(--dsw-alias-bg-base);
+  color: var(--dsw-alias-label-secondary);
+  font-size: 11px;
+  line-height: 16px;
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity 100ms ease;
+}
+
+.root:hover .inspectButton,
+.inspectButton:focus-visible {
+  opacity: 1;
+}
+
+.inspectButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover-solid);
+  color: var(--dsw-alias-label-primary);
+}
+
+.visuallyHidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .inspectButton {
+    transition: none;
+  }
+}
diff --git a/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
new file mode 100644
index 0000000000..1debf2819b
--- /dev/null
+++ b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
@@ -0,0 +1,192 @@
+/** Dedicated `vision_inspect` presentation: visual identity plus replay-stable evidence disclosure. */
+import { useEffect, useRef, useState, type ReactNode } from 'react'
+import {
+  DisclosureRow, ElapsedTime, IconInspectOutline12, StateDot,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ToolCallViewProps } from '@deepseek-ai/dsh-client-ui-tool/client'
+import { VisionInspectIcon } from './VisionInspectIcon.tsx'
+import { useThrottledVisualUpdate } from './use-throttled-visual-update.ts'
+import css from './VisionInspectRow.module.css'
+
+type VisionState = 'running' | 'ok' | 'error' | 'stopped'
+
+interface VisionModel {
+  readonly argsRaw: string
+  readonly output: string | null
+  readonly summary: string
+  readonly state: VisionState
+}
+function compactMarkdownLine(text: string): string {
+  return text
+    .replace(/^#{1,6}\s+/, '')
+    .replace(/^[-+*]\s+/, '')
+    .replace(/\*\*([^*]+)\*\*/g, '$1')
+    .replace(/__([^_]+)__/g, '$1')
+    .trim()
+}
+
+function firstLine(text: string): string {
+  return compactMarkdownLine(text.trim().split(/\r?\n/, 1)[0] ?? '')
+}
+
+function latestLine(text: string): string {
+  const lines = text.trimEnd().split(/\r?\n/)
+  for (let index = lines.length - 1; index >= 0; index -= 1) {
+    const line = lines[index]?.trim()
+    if (line !== undefined && line !== '') return compactMarkdownLine(line)
+  }
+  return ''
+}
+
+function resultText(block: ToolCallViewProps['block']): string | null {
+  if (!('kind' in block)) return null
+  const parts = block.content.map(item => item.type === 'text' ? item.text : JSON.stringify(item, null, 2))
+  if (parts.length === 0 && block.error !== undefined) parts.push(`${block.error.name}: ${block.error.code}`)
+  return parts.join('\n') || null
+}
+
+function promptSummary(argsRaw: string, callId: string): string {
+  try {
+    const parsed = JSON.parse(argsRaw) as unknown
+    if (typeof parsed === 'object' && parsed !== null) {
+      const prompt = (parsed as Record<string, unknown>).prompt
+      if (typeof prompt === 'string' && prompt.trim() !== '') return firstLine(prompt.trim())
+    }
+  } catch {
+    // Streaming arguments may be an incomplete JSON prefix.
+  }
+  return argsRaw === '' ? callId : firstLine(argsRaw)
+}
+
+function visionModel(block: ToolCallViewProps['block']): VisionModel {
+  const settled = 'kind' in block
+  const argsRaw = (settled ? block.call?.argsRaw : block.argsRaw) ?? ''
+  const output = resultText(block)
+  const progress = block.progressText?.trim() ?? ''
+  const state: VisionState = !settled
+    ? 'running'
+    : block.error?.code === 'interrupted'
+      ? 'stopped'
+      : block.isError ? 'error' : 'ok'
+  return {
+    argsRaw,
+    output,
+    summary: state === 'error' && output !== null
+      ? firstLine(output)
+      : state === 'ok' && output !== null
+        ? firstLine(output) || firstLine(progress) || promptSummary(argsRaw, block.callId)
+        : progress || promptSummary(argsRaw, block.callId),
+    state,
+  }
+}
+
+function leadingFor(state: VisionState): ReactNode {
+  switch (state) {
+    case 'error': return <StateDot state="error" />
+    case 'stopped': return <StateDot state="warning" />
+    default: return <VisionInspectIcon />
+  }
+}
+
+function accessibleState(state: VisionState): string | null {
+  switch (state) {
+    case 'running': return 'Vision inspection running'
+    case 'error': return 'Vision inspection failed'
+    case 'stopped': return 'Vision inspection stopped'
+    default: return null
+  }
+}
+
+/** Render a visual inspection with a domain icon and Think-shaped activity title. */
+export function VisionInspectRow({ block, inspect }: ToolCallViewProps) {
+  const model = visionModel(block)
+  const [expanded, setExpanded] = useState(false)
+  const summaryRef = useRef<HTMLSpanElement>(null)
+  const startedTime = 'kind' in block ? block.callTime : block.time
+  const finishedTime = 'kind' in block ? block.time : undefined
+  const presentingRunning = model.state === 'running'
+  const expandable = model.output !== null || model.argsRaw !== ''
+  const open = expanded && expandable
+  const status = accessibleState(model.state)
+  const summary = presentingRunning ? latestLine(model.summary) : firstLine(model.summary)
+  const scheduleSummaryScroll = useThrottledVisualUpdate(() => {
+    const element = summaryRef.current
+    if (element === null) return
+    element.scrollLeft = presentingRunning ? element.scrollWidth - element.clientWidth : 0
+  })
+  useEffect(() => {
+    scheduleSummaryScroll()
+  }, [presentingRunning, scheduleSummaryScroll, summary])
+  return (
+    <div
+      className={css.root}
+      data-tool="vision_inspect"
+      data-state={model.state}
+      data-tool-activity-placement="inline"
+    >
+      {status !== null && <span className={css.visuallyHidden}>{status}</span>}
+      <DisclosureRow
+        rowClassName={css.row}
+        leadingClassName={css.leading}
+        titleClassName={css.title}
+        chevronClassName={css.chevron}
+        icon={leadingFor(model.state)}
+        title="Look"
+        titleSuffix={presentingRunning || startedTime !== null ? (
+          <span className={css.activity} data-look-activity>
+            {presentingRunning && <span data-look-status aria-hidden>ing</span>}
+            {startedTime !== null && (
+              <ElapsedTime
+                className={css.timer}
+                startedTime={startedTime}
+                finishedTime={finishedTime}
+              />
+            )}
+          </span>
+        ) : undefined}
+        open={open}
+        expandable={expandable}
+        expandOnRowClick
+        keepContentWhenOpen
+        onToggle={() => { setExpanded(value => !value) }}
+        collapsedContent={(
+          <>
+            <span className={css.separator} aria-hidden />
+            <span
+              ref={summaryRef}
+              className={model.state === 'error' ? `${css.summary} ${css.errorSummary}` : css.summary}
+              data-follow-end={presentingRunning || undefined}
+              data-vision-summary
+            >
+              {summary}
+            </span>
+          </>
+        )}
+      >
+        <div className={css.bodyWrap}>
+          <div className={css.ioCard}>
+            {model.argsRaw !== '' && (
+              <section className={css.ioSection}>
+                <span className={css.ioLabel}>IN</span>
+                <pre className={css.ioText}>{model.argsRaw}</pre>
+              </section>
+            )}
+            {model.argsRaw !== '' && model.output !== null && <span className={css.ioDivider} aria-hidden />}
+            {model.output !== null && (
+              <section className={css.ioSection}>
+                <span className={css.ioLabel}>OUT</span>
+                <pre className={css.ioText} data-error={model.state === 'error' || undefined}>{model.output}</pre>
+              </section>
+            )}
+          </div>
+          {inspect !== undefined && (
+            <button type="button" className={css.inspectButton} onClick={inspect}>
+              <IconInspectOutline12 />
+              Inspect
+            </button>
+          )}
+        </div>
+      </DisclosureRow>
+    </div>
+  )
+}
