+/** Compact eye glyph for the visual sub-agent Tool row. */
+export function VisionInspectIcon({ size = 14, className }: {
+  readonly size?: number
+  readonly className?: string | undefined
+}) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      className={className}
+      viewBox="0 0 14 14"
+      fill="none"
+      xmlns="http://www.w3.org/2000/svg"
+      aria-hidden
+      data-icon="look"
+    >
+      <path
