diff --git a/packages/vision/vision-bridge/src/index.ts b/packages/vision/vision-bridge/src/index.ts
new file mode 100644
index 0000000000..e97d6559de
--- /dev/null
+++ b/packages/vision/vision-bridge/src/index.ts
@@ -0,0 +1,575 @@
+/**
+ * Default-enabled visual sub-agent bridge for text-only main-model routes.
+ *
+ * New image-bearing user messages receive one durable adjacent reminder. The
+ * bridge tool resolves only images referenced by the current session and sends
+ * their bytes to an administrator-configured OpenAI-compatible vision model.
+ * @module @deepseek-ai/dsh-vision-bridge
+ */
+
+import { basename, extname } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type {
+  ImageAttachmentRef,
+  ImageMediaType,
+  SaveImageAttachment,
+  StoredImageAttachment,
+} from '@deepseek-ai/dsh-attachment'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import { FsError } from '@deepseek-ai/dsh-fs'
+import type { FsInfo, FsTarget } from '@deepseek-ai/dsh-fs'
+import { launchEnvironmentOf } from '@deepseek-ai/dsh-launch-environment'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import type { ToolDefinition, ToolRunContext } from '@deepseek-ai/dsh-tools'
+import type {} from '@deepseek-ai/dsh-agent'
+import { VISION_INSPECT_TOOL_NAME } from './tool-name.ts'
+
+export { VISION_INSPECT_TOOL_NAME } from './tool-name.ts'
+
+/** Cordis plugin name used in durable reminder provenance. */
+export const name = 'vision-bridge'
+
+/** Services required for durable image resolution and tool registration. */
+export const inject = ['attachments', 'tools']
+
+/** Default environment reference for the vision gateway credential. */
+export const DEFAULT_VISION_API_KEY_ENV = 'QWEN_VISION_API_KEY'
+/** Default environment variable carrying the OpenAI-compatible endpoint base. */
+export const DEFAULT_VISION_BASE_URL_ENV = 'DSH_VISION_BASE_URL'
+/** Default remote visual sub-agent model. */
+export const DEFAULT_VISION_MODEL = 'Qwen3.8-Flash-Next-FP8'
+/** Default cooperative call timeout. */
+export const DEFAULT_VISION_TIMEOUT_MS = 120_000
+/** Default image-count bound for one visual inspection, aligned with 0.1.1 attachment admission. */
+export const DEFAULT_VISION_MAX_IMAGES = 20
+/** Default generated-token bound for one visual inspection. */
+export const DEFAULT_VISION_MAX_OUTPUT_TOKENS = 4096
+
+/** Deployment configuration. The base composition loads this plugin by default. */
+export interface Config {
+  /** OpenAI-compatible endpoint base; `/chat/completions` is appended when absent. */
+  baseURL?: string
+  /** Literal gateway key; prefer {@link apiKeyEnv}. */
+  apiKey?: string
+  /** Credential reference resolved once per call. */
+  apiKeyEnv?: string
+  /** Visual sub-agent model id. */
+  model?: string
+  /** Cooperative timeout budget for `vision_inspect`. */
+  timeoutMs?: number
+  /** Maximum number of current-session images accepted by one call. */
+  maxImagesPerCall?: number
+  /** Maximum output tokens requested from the visual sub-agent. */
+  maxOutputTokens?: number
+}
+export const Config: z<Config> = z.object({
+  baseURL: z.string(),
+  apiKey: z.string().role('secret'),
+  apiKeyEnv: z.string().role('credential-ref').default(DEFAULT_VISION_API_KEY_ENV),
+  model: z.string().default(DEFAULT_VISION_MODEL),
+  timeoutMs: z.number().step(1).min(1).default(DEFAULT_VISION_TIMEOUT_MS),
+  maxImagesPerCall: z.number().step(1).min(1).default(DEFAULT_VISION_MAX_IMAGES),
+  maxOutputTokens: z.number().step(1).min(1).default(DEFAULT_VISION_MAX_OUTPUT_TOKENS),
+})
+
+/** Fully resolved, secret-bearing runtime options. */
+export interface VisionBridgeOptions {
+  readonly baseURL: string
+  readonly apiKey?: string
+  readonly apiKeyEnv: string
+  readonly model: string
+  readonly timeoutMs: number
+  readonly maxImagesPerCall: number
+  readonly maxOutputTokens: number
+}
+
+/** Model-invisible durable record of local files imported for this session. */
+export interface VisionImageImportEventData {
+  readonly attachments: ImageAttachmentRef[]
+}
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Local images admitted by `vision_inspect`; log-only and absent from model history. */
+    'vision/image-import': VisionImageImportEventData
+  }
+}
+
+type FetchLike = (input: string | URL | Request, init?: RequestInit) => Promise<Response>
+
+/** Escape untrusted attachment metadata embedded in the XML-shaped reminder. */
+function escapeXml(value: string): string {
+  return value
+    .replaceAll('&', '&amp;')
+    .replaceAll('<', '&lt;')
+    .replaceAll('>', '&gt;')
+    .replaceAll('"', '&quot;')
+    .replaceAll("'", '&apos;')
+}
+
+/**
+ * Render the one durable reminder paired with an image-bearing user message.
+ * @param refs - durable image references from that one human message.
+ * @returns the XML-shaped reminder text stored in the adjacent user event.
+ */
+export function renderImageReminder(
+  refs: readonly ImageAttachmentRef[],
+  localPaths: ReadonlyMap<string, string | undefined> = new Map(),
+): string {
+  const items = refs.map((ref) => {
+    const displayName = ref.name === undefined ? '' : `，name: ${escapeXml(ref.name)}`
+    const localPath = localPaths.get(String(ref.attachmentId))
+    const renderedPath = localPath === undefined ? 'unavailable' : escapeXml(localPath)
+    return `- attachment_id: ${escapeXml(String(ref.attachmentId))}${displayName}，media_type: ${ref.mediaType}，local_path: ${renderedPath}`
+  }).join('\n')
+  return `<system-reminder>\n本条用户消息包含图片，已保存到当前对话：\n${items}\n可使用 local_path 配合现有工具做确定性文件或像素分析；需要视觉理解时调用 ${VISION_INSPECT_TOOL_NAME}。\n</system-reminder>`
+}
+
+/** Collect only top-level durable image references from one uploaded user message. */
+function imageRefs(message: UserMessage): ImageAttachmentRef[] {
+  return message.content.flatMap(block => block.type === 'image' ? [block.attachment] : [])
+}
+
+/**
+ * Insert a reminder immediately after each newly claimed human image message.
+ * Existing history is not inspected or regenerated: once the returned pair is
+ * appended by the agent loop, future requests replay the exact durable prefix.
+ * @param messages - newly claimed messages returned by downstream pre-step hooks.
+ * @returns the messages with one notice adjacent to each human image message.
+ */
+export function addImageReminders(
+  messages: readonly UserMessage[],
+  localPaths: ReadonlyMap<string, string | undefined> = new Map(),
+): UserMessage[] {
+  const expanded: UserMessage[] = []
+  for (const message of messages) {
+    expanded.push(message)
+    if (message.source.kind !== 'user') continue
+    const refs = imageRefs(message)
+    if (refs.length === 0) continue
+    expanded.push(createUserMessage({
+      content: [{ type: 'text', text: renderImageReminder(refs, localPaths) }],
+      source: {
+        kind: 'plugin',
+        plugin: name,
+        form: 'notice',
+        summary: `用户上传了 ${String(refs.length)} 张图片`,
+      },
+    }))
+  }
+  return expanded
+}
+
+/** Find an uploaded or locally imported image reference in the complete current-session event log. */
+function findSessionImage(events: readonly SessionEvent[], attachmentId: string): ImageAttachmentRef | undefined {
+  for (const event of events) {
+    if (event.type === 'user/message') {
+      for (const block of event.data.content) {
+        if (block.type === 'image' && String(block.attachment.attachmentId) === attachmentId) {
+          return block.attachment
+        }
+      }
+      continue
+    }
+    if (event.type === 'vision/image-import') {
+      const ref = event.data.attachments.find(item => String(item.attachmentId) === attachmentId)
+      if (ref !== undefined) return ref
+    }
+  }
+  return undefined
+}
+
+const IMAGE_MEDIA_TYPES: Readonly<Record<string, ImageMediaType>> = {
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.gif': 'image/gif',
+}
+
+interface ResolvedPathImage {
+  readonly target: FsTarget
+  readonly info: FsInfo
+  readonly mediaType: ImageMediaType
+}
+
+/** Resolve and admit local image paths through the mounted filesystem and attachment services. */
+async function importPathImages(
+  ctx: Context,
+  paths: readonly string[],
+  exec: ToolRunContext,
+): Promise<ImageAttachmentRef[]> {
+  if (paths.length === 0) return []
+  const fs = ctx.get('fs')
+  if (fs === undefined) throw new Error('vision_inspect cannot import local paths: no filesystem service is mounted')
+  const candidates: Array<{ requestedPath: string; mediaType: ImageMediaType }> = []
+  for (const rawPath of paths) {
+    const requestedPath = rawPath.trim()
+    if (requestedPath.length === 0) throw new Error('vision_inspect paths must contain non-empty strings')
+    const mediaType = IMAGE_MEDIA_TYPES[extname(requestedPath).toLowerCase()]
+    if (mediaType === undefined) {
+      throw new Error(`cannot inspect "${requestedPath}": vision_inspect only accepts PNG/JPEG/WebP/GIF paths`)
+    }
+    if (!ctx.attachments.imageLimits.mediaTypes.includes(mediaType)) {
+      throw new Error(`cannot inspect "${requestedPath}": ${mediaType} images are not accepted by this deployment`)
+    }
+    candidates.push({ requestedPath, mediaType })
+  }
+
+  // Resolve and stat the whole batch before reading bytes. Canonical target ids
+  // dedupe aliases while preserving first-seen order and filename metadata.
+  const resolved: ResolvedPathImage[] = []
+  const targetKeys = new Set<string>()
+  const cwd = exec.agent?.session.header.cwd
+  for (const candidate of candidates) {
+    const target = await fs.resolve(candidate.requestedPath, {
+      ...cwd === undefined ? {} : { cwd },
+      signal: exec.signal,
+    })
+    const info = await fs.stat(target, exec.signal)
+    if (info === undefined) {
+      ctx.emit('fs/observed', target, { kind: 'absent' }, exec)
+      throw new FsError(`cannot inspect "${target.displayPath}": not found`, 'FS_NOT_FOUND')
+    }
+    if (info.type !== 'file') {
+      throw new FsError(`cannot inspect "${target.displayPath}": not a regular file`, 'FS_NOT_REGULAR_FILE')
+    }
+    const targetKey = String(target.targetKey)
+    if (targetKeys.has(targetKey)) continue
+    targetKeys.add(targetKey)
+    resolved.push({ target, info, mediaType: candidate.mediaType })
+  }
+  if (resolved.length > ctx.attachments.imageLimits.maxImagesPerMessage) {
+    throw new Error(`vision_inspect accepts at most ${String(ctx.attachments.imageLimits.maxImagesPerMessage)} local image paths per call`)
+  }
+
+  const byteCap = Math.min(
+    ctx.attachments.imageLimits.maxImageBytes,
+    ctx.attachments.imageLimits.maxMessageImageBytes,
+  )
+  const inputs: SaveImageAttachment[] = []
+  for (const item of resolved) {
+    inputs.push({
+      data: await fs.readBytes(item.target, exec.signal, byteCap),
+      mediaType: item.mediaType,
+      name: basename(item.target.displayPath),
+    })
+  }
+  const refs = [...await ctx.attachments.saveImages(inputs)]
+  for (const item of resolved) {
+    ctx.emit('fs/observed', item.target, { kind: 'present', version: item.info.version }, exec)
+  }
+  return refs
+}
+
+/** Normalize an endpoint base without leaking it into model-visible errors. */
+function chatCompletionsURL(baseURL: string): string {
+  const trimmed = baseURL.replace(/\/+$/, '')
+  return trimmed.endsWith('/chat/completions') ? trimmed : `${trimmed}/chat/completions`
+}
+
+/** Extract text from OpenAI-compatible string or text-part response content. */
+function responseText(payload: unknown): string | undefined {
+  if (typeof payload !== 'object' || payload === null || Array.isArray(payload)) return undefined
+  const choices = (payload as { choices?: unknown }).choices
+  if (!Array.isArray(choices) || choices.length === 0) return undefined
+  const first = (choices as unknown[])[0]
+  if (typeof first !== 'object' || first === null || Array.isArray(first)) return undefined
+  const message = (first as { message?: unknown }).message
+  if (typeof message !== 'object' || message === null || Array.isArray(message)) return undefined
+  const content = (message as { content?: unknown }).content
+  if (typeof content === 'string') return content
+  if (!Array.isArray(content)) return undefined
+  const parts = content.flatMap((part) => {
+    if (typeof part !== 'object' || part === null || Array.isArray(part)) return []
+    const record = part as { type?: unknown; text?: unknown }
+    return record.type === 'text' && typeof record.text === 'string' ? [record.text] : []
+  })
+  return parts.length === 0 ? undefined : parts.join('')
+}
+
+/** Extract one OpenAI-compatible streamed assistant text fragment. */
+function responseDeltaText(payload: unknown): string | undefined {
+  if (typeof payload !== 'object' || payload === null || Array.isArray(payload)) return undefined
+  const choices = (payload as { choices?: unknown }).choices
+  if (!Array.isArray(choices) || choices.length === 0) return undefined
+  const first = (choices as unknown[])[0]
+  if (typeof first !== 'object' || first === null || Array.isArray(first)) return undefined
+  const delta = (first as { delta?: unknown }).delta
+  if (typeof delta !== 'object' || delta === null || Array.isArray(delta)) return undefined
+  const content = (delta as { content?: unknown }).content
+  if (typeof content === 'string') return content
+  if (!Array.isArray(content)) return undefined
+  const parts = content.flatMap((part) => {
+    if (typeof part !== 'object' || part === null || Array.isArray(part)) return []
+    const record = part as { type?: unknown; text?: unknown }
+    return record.type === 'text' && typeof record.text === 'string' ? [record.text] : []
+  })
+  return parts.length === 0 ? undefined : parts.join('')
+}
+
+/** Return the earliest complete SSE record and retain the unconsumed suffix. */
+function takeSseRecord(buffer: string): { record: string; rest: string } | undefined {
+  const boundaries = ['\r\n\r\n', '\n\n', '\r\r']
+    .map(marker => ({ marker, index: buffer.indexOf(marker) }))
+    .filter(candidate => candidate.index >= 0)
+    .sort((left, right) => left.index - right.index)
+  const boundary = boundaries[0]
+  if (boundary === undefined) return undefined
+  return {
+    record: buffer.slice(0, boundary.index),
+    rest: buffer.slice(boundary.index + boundary.marker.length),
+  }
+}
+
+/** Parse and publish one SSE record, returning its assistant text fragment. */
+function readSseRecord(record: string): string {
+  const data = record.split(/\r\n|\r|\n/)
+    .filter(line => line.startsWith('data:'))
+    .map(line => line.slice(5).replace(/^ /, ''))
+    .join('\n')
+  if (data === '' || data === '[DONE]') return ''
+  let payload: unknown
+  try {
+    payload = JSON.parse(data)
+  } catch (error: unknown) {
+    throw new Error('vision service returned invalid streaming JSON', { cause: error })
+  }
+  return responseDeltaText(payload) ?? ''
+}
+
+/** Consume either an SSE stream or a compatibility non-streaming JSON response. */
+async function readResponseText(response: Response, onDelta: (delta: string) => void): Promise<string> {
+  if (!response.headers.get('content-type')?.toLowerCase().includes('text/event-stream')) {
+    let payload: unknown
+    try {
+      payload = await response.json()
+    } catch (error: unknown) {
+      throw new Error('vision service returned invalid JSON', { cause: error })
+    }
+    const text = responseText(payload)
+    if (text === undefined) throw new Error('vision service response did not contain assistant text')
+    return text
+  }
+  if (response.body === null) throw new Error('vision service response did not contain assistant text')
+  const reader = response.body.getReader()
+  const decoder = new TextDecoder()
+  let buffer = ''
+  let text = ''
+  const accept = (record: string) => {
+    const delta = readSseRecord(record)
+    if (delta === '') return
+    text += delta
+    onDelta(delta)
+  }
+  while (true) {
+    const chunk = await reader.read()
+    buffer += decoder.decode(chunk.value, { stream: !chunk.done })
+    let next = takeSseRecord(buffer)
+    while (next !== undefined) {
+      accept(next.record)
+      buffer = next.rest
+      next = takeSseRecord(buffer)
+    }
+    if (chunk.done) break
+  }
+  if (buffer.trim() !== '') accept(buffer)
+  if (text === '') throw new Error('vision service response did not contain assistant text')
+  return text
+}
+
+/** Resolve the configured credential for one request. */
+async function resolveApiKey(ctx: Context, options: VisionBridgeOptions): Promise<string | undefined> {
+  if (options.apiKey !== undefined && options.apiKey.length > 0) return options.apiKey
+  const ref = credentialRef(options.apiKeyEnv)
+  const credentials = ctx.get('credentials')
+  if (credentials !== undefined) return (await credentials.resolve(ref))?.value
+  const ambient = launchEnvironmentOf(ctx).get(ref)?.value
+  return ambient !== undefined && ambient.length > 0 ? ambient : undefined
+}
+
+/** Run one authorized inspection against the configured OpenAI-compatible visual sub-agent. */
+async function inspect(
+  ctx: Context,
+  options: VisionBridgeOptions,
+  attachmentIds: readonly string[] | undefined,
+  paths: readonly string[] | undefined,
+  prompt: string,
+  exec: ToolRunContext,
+  fetchImpl: FetchLike,
+): Promise<string> {
+  const agent = exec.agent
+  if (agent === undefined) throw new Error('vision_inspect requires an active agent session')
+  const uniqueAttachmentIds = [...new Set(attachmentIds ?? [])]
+  const requestedPaths = paths ?? []
+  if (uniqueAttachmentIds.length === 0 && requestedPaths.length === 0) {
+    throw new Error('vision_inspect requires at least one attachmentId or path')
+  }
+  if (uniqueAttachmentIds.length > options.maxImagesPerCall) {
+    throw new Error(`vision_inspect accepts at most ${String(options.maxImagesPerCall)} images per call`)
+  }
+
+  // Authorize every referenced attachment before reading any file bytes or
+  // contacting the gateway. Imported refs are recorded in a log-only event.
+  const existingRefs = uniqueAttachmentIds.map((attachmentId) => {
+    const ref = findSessionImage(agent.session.events, attachmentId)
+    if (ref === undefined) throw new Error(`attachment "${attachmentId}" is not available in the current session`)
+    return ref
+  })
+  const importedRefs = await importPathImages(ctx, requestedPaths, exec)
+  const refsById = new Map(existingRefs.map(ref => [String(ref.attachmentId), ref]))
+  for (const ref of importedRefs) refsById.set(String(ref.attachmentId), refsById.get(String(ref.attachmentId)) ?? ref)
+  const refs = [...refsById.values()]
+  if (refs.length > options.maxImagesPerCall) {
+    throw new Error(`vision_inspect accepts at most ${String(options.maxImagesPerCall)} images per call`)
+  }
+  const newlyImported = importedRefs.filter(ref => findSessionImage(agent.session.events, String(ref.attachmentId)) === undefined)
+  if (newlyImported.length > 0) {
+    agent.session.append('vision/image-import', { attachments: newlyImported })
+  }
+  const stored: StoredImageAttachment[] = []
+  for (const ref of refs) stored.push(await ctx.attachments.readImage(ref, exec.signal))
+  const apiKey = await resolveApiKey(ctx, options)
+  exec.signal.throwIfAborted()
+  let response: Response
+  try {
+    response = await fetchImpl(chatCompletionsURL(options.baseURL), {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        ...apiKey === undefined ? {} : { authorization: `Bearer ${apiKey}` },
+      },
+      body: JSON.stringify({
+        model: options.model,
+        stream: true,
+        temperature: 0,
+        max_tokens: options.maxOutputTokens,
+        // vLLM's Qwen chat template accepts this OpenAI-compatible extension;
+        // visual observation should spend tokens on evidence, not a hidden CoT.
+        chat_template_kwargs: { enable_thinking: false },
+        messages: [{
+          role: 'system',
+          content: '你是视觉子智能体。结合用户给出的完整任务检查所有图片，只输出简洁、任务导向的 Markdown 正文。'
+            + '先直接回答问题，再按需列出可见证据和必要限制。不要输出 JSON 或 Markdown 代码围栏，不要猜测不可见内容。',
+        }, {
+          role: 'user',
+          content: [
+            { type: 'text', text: prompt },
+            ...stored.flatMap((image, index) => [{
+              type: 'text',
+              text: `图片 ${String(index + 1)}：attachment_id=${String(image.ref.attachmentId)}${image.ref.name === undefined ? '' : `，name=${image.ref.name}`}`,
+            }, {
+              type: 'image_url',
+              image_url: { url: `data:${image.ref.mediaType};base64,${Buffer.from(image.data).toString('base64')}` },
+            }]),
+          ],
+        }],
+      }),
+      signal: exec.signal,
+    })
+  } catch (error: unknown) {
+    if (exec.signal.aborted) throw exec.signal.reason
+    throw new Error('vision service request failed', { cause: error })
+  }
+  if (!response.ok) throw new Error(`vision service request failed with HTTP ${String(response.status)}`)
+  const text = await readResponseText(response, (delta) => {
+    exec.reportProgress(delta)
+  })
+  const markdown = text.trim()
+  if (markdown.length === 0) throw new Error('vision service response did not contain usable assistant text')
+  return markdown
+}
+
+/**
+ * Build the model-facing tool; injectable fetch keeps gateway tests network-free.
+ * @param ctx - Cordis context used to resolve attachments and credentials.
+ * @param options - validated deployment route and request limits.
+ * @param fetchImpl - OpenAI-compatible transport implementation.
+ * @returns the registered `vision_inspect` definition.
+ */
+export function createVisionInspectTool(
+  ctx: Context,
+  options: VisionBridgeOptions,
+  fetchImpl: FetchLike = globalThis.fetch,
+): ToolDefinition {
+  return defineTool({
+    name: VISION_INSPECT_TOOL_NAME,
+    description: 'Inspect conversation attachments or local image files with the configured vision model.',
+    parameters: {
+      attachmentIds: {
+        type: 'array',
+        items: { type: 'string' },
+        description: 'Current-conversation attachment IDs to inspect.',
+      },
+      paths: {
+        type: 'array',
+        items: { type: 'string' },
+        description: 'Image file paths to import into this conversation and inspect.',
+      },
+      prompt: {
+        type: 'string',
+        required: true,
+        description: 'The complete visual question or inspection task.',
+      },
+    },
+    output: {
+      schema: { type: 'string' },
+      render: (_args, value) => [{ type: 'text', text: value }],
+    },
+    timeoutMs: options.timeoutMs,
+    isConcurrencySafe: () => true,
+    execute: (args, exec) => inspect(ctx, options, args.attachmentIds, args.paths, args.prompt, exec, fetchImpl),
+  })
+}
+
+/** Resolve and validate deployment options without exposing secrets. */
+function resolveOptions(ctx: Context, config: Config): VisionBridgeOptions {
+  const resolved = Config(config) as Required<Omit<Config, 'baseURL' | 'apiKey'>> & Pick<Config, 'baseURL' | 'apiKey'>
+  // A workspace-controlled project .env must never redirect a managed gateway
+  // credential. Composition config is operator-owned; the environment fallback
+  // therefore accepts only the inherited process and Harness-user layers.
+  const baseURL = resolved.baseURL
+    ?? launchEnvironmentOf(ctx).getFrom(DEFAULT_VISION_BASE_URL_ENV, ['process', 'user-env'])?.value
+  if (baseURL === undefined || baseURL.trim().length === 0) {
+    throw new Error(`vision-bridge: baseURL or ${DEFAULT_VISION_BASE_URL_ENV} is required when the plugin is enabled`)
+  }
+  credentialRef(resolved.apiKeyEnv)
+  return {
+    baseURL: baseURL.trim(),
+    ...resolved.apiKey === undefined ? {} : { apiKey: resolved.apiKey },
+    apiKeyEnv: resolved.apiKeyEnv,
+    model: resolved.model,
+    timeoutMs: resolved.timeoutMs,
+    maxImagesPerCall: resolved.maxImagesPerCall,
+    maxOutputTokens: resolved.maxOutputTokens,
+  }
+}
+
+/** Enable bridged admission, durable reminders, and the visual inspection tool. */
+export function apply(ctx: Context, config: Config): void {
+  const options = resolveOptions(ctx, config)
+  ctx.provide('imageInputBridge', { canHandle: () => true })
+  ctx.tools.register(createVisionInspectTool(ctx, options))
+  ctx.on('agent/pre-step', async ({ agent, signal }, next) => {
+    const downstream = await next()
+    if (downstream.kind === 'reject') return downstream
+    const localPaths = new Map<string, string | undefined>()
+    const refs = downstream.messages.flatMap(imageRefs)
+    for (const ref of refs) {
+      const attachmentId = String(ref.attachmentId)
+      if (localPaths.has(attachmentId)) continue
+      try {
+        localPaths.set(attachmentId, ctx.attachments.imageHostPath(ref))
+      } catch (error) {
+        if (signal.aborted) throw signal.reason
+        ctx.logger.warn(`vision-bridge: could not resolve ${attachmentId} for session ${String(agent.session.id)}: ${String(error)}`)
+        localPaths.set(attachmentId, undefined)
+      }
+    }
+    return { kind: 'enter' as const, messages: addImageReminders(downstream.messages, localPaths) }
+  })
+}
