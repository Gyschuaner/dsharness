+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { ToolRunContext } from '@deepseek-ai/dsh-tools'
+import * as VisionBridge from '@deepseek-ai/dsh-vision-bridge'
+import type { VisionBridgeOptions } from '@deepseek-ai/dsh-vision-bridge'
+
+const ID = `sha256:${'1'.repeat(64)}`
+const REF: ImageAttachmentRef = {
+  attachmentId: AttachmentId(ID),
+  mediaType: 'image/png',
+  bytes: 1,
+  width: 1,
+  height: 1,
+  name: 'screen<&>.png',
+}
+
+const OPTIONS: VisionBridgeOptions = {
+  baseURL: 'http://vision.test/v1',
+  apiKey: 'secret',
+  apiKeyEnv: 'QWEN_VISION_API_KEY',
+  model: 'qwen-vision',
+  timeoutMs: 30_000,
+  maxImagesPerCall: 3,
+  maxOutputTokens: 1024,
+}
+
+function eventWithImage(): SessionEvent {
+  return {
+    type: 'user/message',
+    seq: 1,
+    at: 1,
+    data: createUserMessage({ content: [{ type: 'image', attachment: REF }], source: { kind: 'user' } }),
+    meta: { surfaceOp: 'append' },
+  } as unknown as SessionEvent
+}
+
+function execution(events: readonly SessionEvent[], signal = new AbortController().signal): ToolRunContext {
+  return {
+    signal,
+    agent: { session: { events } },
+    reportProgress: vi.fn(),
+  } as unknown as ToolRunContext
+}
+
+function context(readImage = vi.fn().mockResolvedValue({ ref: REF, data: Uint8Array.of(1) })) {
+  return {
+    attachments: {
+      imageLimits: {
+        maxImageBytes: 4,
+        maxImagesPerMessage: 20,
+        maxMessageImageBytes: 4,
+        maxImagePixels: 4,
+        maxImageDimension: 2000,
+        mediaTypes: ['image/png'],
+      },
+      readImage,
+    },
+    get: () => undefined,
+  } as unknown as Context
+}
+
+function jsonResponse(payload: unknown, status = 200): Response {
+  return new Response(JSON.stringify(payload), {
+    status,
+    headers: { 'content-type': 'application/json' },
+  })
+}
+
+describe('durable image reminder', () => {
+  it('renders full attachment ids and escapes untrusted metadata', () => {
+    const reminder = VisionBridge.renderImageReminder([REF], new Map([[ID, 'D:/session/<image>.png']]))
+    expect(reminder).toContain(`attachment_id: ${ID}`)
+    expect(reminder).toContain('name: screen&lt;&amp;&gt;.png')
+    expect(reminder).toContain('media_type: image/png')
+    expect(reminder).toContain('local_path: D:/session/&lt;image&gt;.png')
+    expect(reminder).toContain('需要视觉理解时调用 vision_inspect。')
+  })
+
+  it('adds one adjacent reminder only for human image messages', () => {
+    const image = createUserMessage({ content: [{ type: 'image', attachment: REF }], source: { kind: 'user' } })
+    const humanText = createUserMessage({ content: [{ type: 'text', text: 'hello' }], source: { kind: 'user' } })
+    const pluginImage = createUserMessage({
+      content: [{ type: 'image', attachment: REF }],
+      source: { kind: 'plugin', plugin: 'fixture', form: 'notice', summary: 'fixture' },
+    })
+    const expanded = VisionBridge.addImageReminders([image, humanText, pluginImage])
+    expect(expanded).toHaveLength(4)
+    expect(expanded[0]).toBe(image)
+    expect(expanded[1]?.source).toMatchObject({ kind: 'plugin', plugin: VisionBridge.name, form: 'notice' })
+    expect(expanded[2]).toBe(humanText)
+    expect(expanded[3]).toBe(pluginImage)
+  })
+})
+
+describe('vision_inspect', () => {
+  it('authorizes the current session before reading bytes or calling the gateway', async () => {
+    const readImage = vi.fn().mockResolvedValue({ ref: REF, data: Uint8Array.of(1) })
+    const fetchImpl = vi.fn(async (input: string | URL | Request, init?: RequestInit) => {
+      expect(input).toBe('http://vision.test/v1/chat/completions')
+      expect((init?.headers as Record<string, string>).authorization).toBe('Bearer secret')
+      const body = JSON.parse(String(init?.body)) as { model: string; stream: boolean; messages: unknown[] }
+      expect(body.model).toBe('qwen-vision')
+      expect(body.stream).toBe(true)
+      expect(JSON.stringify(body.messages)).toContain(`attachment_id=${ID}`)
+      expect(JSON.stringify(body.messages)).toContain('data:image/png;base64,AQ==')
+      return jsonResponse({ choices: [{ message: { content: '一张界面截图' } }] })
+    })
+    const tool = VisionBridge.createVisionInspectTool(context(readImage), OPTIONS, fetchImpl)
+
+    await expect(tool.execute({ attachmentIds: [ID], prompt: '检查按钮' }, execution([eventWithImage()])))
+      .resolves.toBe('一张界面截图')
+    expect(readImage).toHaveBeenCalledOnce()
+    expect(fetchImpl).toHaveBeenCalledOnce()
+
+    await expect(tool.execute(
+      { attachmentIds: [`sha256:${'2'.repeat(64)}`], prompt: '读取其他会话' },
+      execution([eventWithImage()]),
+    )).rejects.toThrow(/not available in the current session/)
+    expect(readImage).toHaveBeenCalledOnce()
+    expect(fetchImpl).toHaveBeenCalledOnce()
+  })
+
+  it('streams Markdown deltas through reportProgress and returns the exact result', async () => {
+    const pieces = ['结论：', '顶部有一个按钮', '\n- 颜色为蓝色']
+    const wire = pieces.map(content => `data: ${JSON.stringify({ choices: [{ delta: { content } }] })}\r\n\r\n`).join('')
+      + 'data: [DONE]\r\n\r\n'
+    const stream = new ReadableStream<Uint8Array>({
+      start(controller) {
+        const encoded = new TextEncoder().encode(wire)
+        controller.enqueue(encoded.slice(0, 11))
+        controller.enqueue(encoded.slice(11))
+        controller.close()
+      },
+    })
+    const reportProgress = vi.fn<(delta: string) => void>()
+    const exec = { ...execution([eventWithImage()]), reportProgress } as never
+    const fetchImpl = vi.fn().mockResolvedValue(new Response(stream, {
+      status: 200,
+      headers: { 'content-type': 'text/event-stream; charset=utf-8' },
+    }))
+    const tool = VisionBridge.createVisionInspectTool(context(), OPTIONS, fetchImpl)
+
+    await expect(tool.execute({ attachmentIds: [ID], prompt: '识别按钮' }, exec))
+      .resolves.toBe(pieces.join(''))
+    expect(reportProgress.mock.calls.map(call => call[0])).toEqual(pieces)
+  })
+
+  it('imports local paths through the native filesystem and attachment services', async () => {
+    const importedId = `sha256:${'2'.repeat(64)}`
+    const importedRef: ImageAttachmentRef = { ...REF, attachmentId: AttachmentId(importedId), name: 'local.png' }
+    const resolve = vi.fn().mockResolvedValue({ targetKey: 'file:local', displayPath: 'D:/workspace/local.png' })
+    const stat = vi.fn().mockResolvedValue({ type: 'file', version: 'v1' })
+    const readBytes = vi.fn().mockResolvedValue(Uint8Array.of(2))
+    const saveImages = vi.fn().mockResolvedValue([importedRef])
+    const readImage = vi.fn(async (ref: ImageAttachmentRef) => ({ ref, data: Uint8Array.of(2) }))
+    const events: SessionEvent[] = [eventWithImage()]
+    const session = {
+      header: { cwd: 'D:/workspace' },
+      get events() { return events },
+      append(type: string, data: unknown) {
+        const event = { type, seq: events.length, time: 1, data } as unknown as SessionEvent
+        events.push(event)
+        return event
+      },
+    }
+    const fs = { resolve, stat, readBytes }
+    const ctx = {
+      attachments: {
+        imageLimits: {
+          maxImageBytes: 4,
+          maxImagesPerMessage: 20,
+          maxMessageImageBytes: 4,
+          maxImagePixels: 4,
+          maxImageDimension: 2000,
+          mediaTypes: ['image/png'],
+        },
+        saveImages,
+        readImage,
+      },
+      get: (key: string) => key === 'fs' ? fs : undefined,
+      emit: vi.fn(),
+    } as unknown as Context
+    const exec = { signal: new AbortController().signal, agent: { session }, reportProgress: vi.fn() } as never
+    const fetchImpl = vi.fn().mockResolvedValue(jsonResponse({ choices: [{ message: { content: 'local' } }] }))
+    const tool = VisionBridge.createVisionInspectTool(ctx, OPTIONS, fetchImpl)
+
+    await expect(tool.execute({ paths: ['local.png'], prompt: '检查本地图片' }, exec)).resolves.toBe('local')
+    expect(resolve).toHaveBeenCalledWith('local.png', { cwd: 'D:/workspace', signal: expect.any(AbortSignal) })
+    expect(readBytes).toHaveBeenCalledOnce()
+    expect(saveImages).toHaveBeenCalledWith([{ data: Uint8Array.of(2), mediaType: 'image/png', name: 'local.png' }])
+    expect(events.some(event => event.type === 'vision/image-import')).toBe(true)
+    expect(fetchImpl).toHaveBeenCalledOnce()
+  })
+})
