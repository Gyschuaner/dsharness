--- /dev/null
+++ b/packages/client/ui-primitives/src/ElapsedTime.tsx
@@ -0,0 +1,34 @@
+/** Live or frozen elapsed-time text shared by compact activity rows. */
+import { useEffect, useState } from 'react'
+
+export interface ElapsedTimeProps {
+  readonly startedTime: number
+  readonly finishedTime?: number | undefined
+  readonly className?: string | undefined
+}
+
+/** Format an elapsed duration for compact activity rows. */
+export function formatElapsedDuration(milliseconds: number): string {
+  const elapsed = Math.max(0, milliseconds)
+  if (elapsed < 1_000) return `${Math.floor(elapsed)}ms`
+  const seconds = Math.floor(elapsed / 1_000)
+  if (seconds < 60) return `${seconds}s`
+  const minutes = Math.floor(seconds / 60)
+  return `${minutes}:${String(seconds % 60).padStart(2, '0')}`
+}
+
+/** Render a live duration, freezing it at an optional completion timestamp. */
+export function ElapsedTime({ startedTime, finishedTime, className }: ElapsedTimeProps) {
+  const [now, setNow] = useState(() => Date.now())
+  const live = finishedTime === undefined
+  useEffect(() => {
+    if (!live) return undefined
+    const interval = globalThis.setInterval(() => { setNow(Date.now()) }, 250)
+    return () => { globalThis.clearInterval(interval) }
+  }, [live])
+  return (
+    <span className={className} data-elapsed-time>
+      {formatElapsedDuration((finishedTime ?? now) - startedTime)}
+    </span>
+  )
+}
