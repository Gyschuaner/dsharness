+function updateProgress(state: ToolState, match: ConversationMatch): ToolState {
+  const event = match.event
+  if (event.type !== 'tool/progress') return state
+  const callId = String(event.data.callId)
+  const root = appendProgress(state.root, callId, event.data.delta)
+  let changedChildren: Map<string, readonly ToolCallBlock[]> | undefined
+  for (const [parentCallId, siblings] of state.children) {
+    const next = siblings.map(child => appendProgress(child, callId, event.data.delta))
+    if (sameReferences(siblings, next)) continue
+    changedChildren ??= new Map(state.children)
+    changedChildren.set(parentCallId, next)
+  }
+  return root === state.root && changedChildren === undefined
+    ? state
+    : { ...state, root, children: changedChildren ?? state.children }
+}
