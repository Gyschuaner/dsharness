@@ -4,6 +4,28 @@ import css from './ToolActivityChrome.module.css'
 export interface ToolActivityChromeProps {
   startedTime: number
   finishedTime?: number | undefined
+  state: 'running' | 'settled'
+}
+
+/** Long enough to survive one coalesced start/result paint without slowing the Tool. */
+export const MIN_TOOL_RUNNING_VISIBLE_MS = 600
+
+/** Preserve one perceptible running phase when a Tool settles inside one paint. */
+export function useToolActivityPresentationState(
+  startedTime: number,
+  finishedTime: number | undefined,
+): 'running' | 'settled' {
+  const [, renderDeadline] = useState(0)
+  const settleAt = finishedTime === undefined
+    ? undefined
+    : Math.max(finishedTime, startedTime + MIN_TOOL_RUNNING_VISIBLE_MS)
+  const running = settleAt === undefined || Date.now() < settleAt
+  useEffect(() => {
+    if (!running || settleAt === undefined) return undefined
+    const timeout = globalThis.setTimeout(() => { renderDeadline(value => value + 1) }, settleAt - Date.now())
+    return () => { globalThis.clearTimeout(timeout) }
+  }, [running, settleAt])
+  return running ? 'running' : 'settled'
 }
 
