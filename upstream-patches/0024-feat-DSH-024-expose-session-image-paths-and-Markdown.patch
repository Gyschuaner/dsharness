new file mode 100644
index 0000000..d5050bc
--- /dev/null
+++ b/packages/attachment/attachment-local/src/session-view.ts
@@ -0,0 +1,98 @@
+/** Stable, session-scoped local views over immutable attachment objects. */
+
+import { createHash, randomUUID } from 'node:crypto'
+import { constants } from 'node:fs'
+import { chmod, link, lstat, open, unlink } from 'node:fs/promises'
+import { dirname, join, resolve } from 'node:path'
+import { AttachmentError } from '@deepseek-ai/dsh-attachment'
+import type { ImageAttachmentRef, MaterializedImageAttachment } from '@deepseek-ai/dsh-attachment'
+import { ensureDurableDirectory, ensureDurableHome, readImageFile, syncDirectory } from './store.ts'
+
+const EXTENSIONS = {
+  'image/png': 'png',
+  'image/jpeg': 'jpg',
+  'image/webp': 'webp',
+  'image/gif': 'gif',
+} as const
+
+function digest(data: Uint8Array | string): string {
+  return createHash('sha256').update(data).digest('hex')
+}
+
+function attachmentDigest(ref: ImageAttachmentRef): string {
+  const match = /^sha256:([a-f0-9]{64})$/.exec(String(ref.attachmentId))
+  if (match?.[1] === undefined) {
+    throw new AttachmentError('Attachment reference is not a valid content address.', 'INVALID_ATTACHMENT_REF')
+  }
+  return match[1]
+}
+
+async function verifyExistingView(target: string, expected: Uint8Array, sha256: string): Promise<void> {
+  let handle: Awaited<ReturnType<typeof open>> | undefined
+  try {
+    const noFollow = 'O_NOFOLLOW' in constants ? constants.O_NOFOLLOW : 0
+    handle = await open(target, constants.O_RDONLY | noFollow)
+    const before = await handle.stat()
+    if (!before.isFile()) throw new Error('session view is not a regular file')
+    const existing = new Uint8Array(await handle.readFile())
+    if (existing.byteLength !== expected.byteLength || digest(existing) !== sha256) {
+      throw new Error('session view content does not match the attachment')
+    }
+    await handle.chmod(0o400)
+    const after = await lstat(target)
+    if (!after.isFile() || after.isSymbolicLink() || after.dev !== before.dev || after.ino !== before.ino) {
+      throw new Error('session view changed during verification')
+    }
+  } catch (error) {
+    throw new AttachmentError('Materialized attachment failed integrity verification.', 'ATTACHMENT_CORRUPT', { cause: error })
+  } finally {
+    await handle?.close().catch(() => {})
+  }
+}
+
+/**
+ * Copy one verified normalized image into a stable, extension-bearing session view.
+ * The copy intentionally does not link to the canonical object: even a caller
+ * that later makes the view writable cannot mutate durable attachment history.
+ */
+export async function materializeImageForSession(
+  root: string,
+  ref: ImageAttachmentRef,
+  sessionScope: string,
+  signal?: AbortSignal,
+): Promise<MaterializedImageAttachment> {
+  signal?.throwIfAborted()
+  const stored = await readImageFile(root, ref, signal)
+  signal?.throwIfAborted()
+  const sha256 = attachmentDigest(stored.ref)
+  const scope = digest(sessionScope)
+  const boundary = await ensureDurableHome(dirname(dirname(resolve(root))))
+  const directory = join(root, 'session-view', scope)
+  await ensureDurableDirectory(directory, boundary)
+  const target = join(directory, `${sha256}.${EXTENSIONS[stored.ref.mediaType]}`)
+  const temporary = join(directory, `.tmp-${randomUUID()}`)
+  let handle: Awaited<ReturnType<typeof open>> | undefined
+  try {
+    handle = await open(temporary, constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY, 0o600)
+    await handle.writeFile(stored.data)
+    await handle.sync()
+    await handle.close()
+    handle = undefined
+    try {
+      await link(temporary, target)
+    } catch (error) {
+      if (!(error instanceof Error && 'code' in error && error.code === 'EEXIST')) throw error
+      await verifyExistingView(target, stored.data, sha256)
+    }
+    await chmod(target, 0o400)
+    await syncDirectory(directory)
+    return { path: resolve(target) }
+  } catch (error) {
+    if (signal?.aborted === true) throw signal.reason
+    if (error instanceof AttachmentError) throw error
+    throw new AttachmentError('Could not publish the session attachment view.', 'ATTACHMENT_WRITE_FAILED', { cause: error })
+  } finally {
+    if (handle !== undefined) await handle.close().catch(() => {})
+    await unlink(temporary).catch(() => {})
+  }
+}
