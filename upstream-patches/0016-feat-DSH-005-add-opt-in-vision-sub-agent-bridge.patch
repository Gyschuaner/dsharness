+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import AttachmentStore, { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { LlmResolvedModelInfo } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import * as VisionBridge from '@deepseek-ai/dsh-vision-bridge'
+import type { VisionBridgeOptions } from '@deepseek-ai/dsh-vision-bridge'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+const ID = `sha256:${'1'.repeat(64)}`
+const REF: ImageAttachmentRef = {
+  attachmentId: AttachmentId(ID),
+  mediaType: 'image/png',
+  bytes: 1,
+  width: 1,
+  height: 1,
+  name: 'screen<&>.png',
+}
+
+const OPTIONS: VisionBridgeOptions = {
+  baseURL: 'http://vision.test/v1',
+  apiKey: 'secret',
+  apiKeyEnv: 'QWEN_VISION_API_KEY',
+  model: 'qwen-vision',
+  timeoutMs: 30_000,
+  maxImagesPerCall: 3,
+  maxOutputTokens: 1024,
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => {
+    const dispose = ctx.on('agent/status', ({ agent: current, status }) => {
+      if (current !== agent || status !== 'idle') return
+      dispose()
+      resolve()
+    })
+  })
+}
+
+class TextOnlyAdapter extends MockAdapter {
+  override resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    return Promise.resolve({ provider, id: model, name: model, inputModalities: ['text'] })
+  }
+}
+
+describe('durable image reminder', () => {
+  it('renders full attachment ids and escapes untrusted names', () => {
+    const reminder = VisionBridge.renderImageReminder([REF])
+    expect(reminder).toContain('<system-reminder>\n本条用户消息包含图片，已保存到当前对话：')
+    expect(reminder).toContain(`attachment_id: ${ID}`)
+    expect(reminder).toContain('name: screen&lt;&amp;&gt;.png')
+    expect(reminder).toContain('需要视觉信息时调用 vision_inspect；不需要时继续处理用户请求。')
+  })
+
+  it('adds exactly one adjacent reminder for each newly claimed human image message', () => {
+    const image = createUserMessage({ content: [{ type: 'image', attachment: REF }], source: { kind: 'user' } })
+    const oldReminder = createUserMessage({
+      content: [{ type: 'text', text: '<system-reminder>old</system-reminder>' }],
+      source: { kind: 'plugin', plugin: VisionBridge.name, form: 'notice', summary: 'old' },
+    })
+    const expanded = VisionBridge.addImageReminders([image, oldReminder])
+    expect(expanded).toHaveLength(3)
+    expect(expanded[0]).toBe(image)
+    expect(expanded[1]?.source).toMatchObject({ kind: 'plugin', plugin: VisionBridge.name, form: 'notice' })
+    expect(expanded[2]).toBe(oldReminder)
+  })
+
+  it('persists the reminder once and replays a stable text-only prefix on later turns', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx, { systemPrompt: { persona: '' } })
+    const readImage = vi.fn().mockResolvedValue({ ref: REF, data: Uint8Array.of(1) })
+    ctx.provide('attachments', Object.setPrototypeOf({
+      imageLimits: {
+        maxImageBytes: 4,
+        maxImagesPerMessage: 2,
+        maxMessageImageBytes: 4,
+        maxImagePixels: 4,
+        maxImageDimension: 2000,
+        mediaTypes: ['image/png'],
+      },
+      readImage,
+    }, AttachmentStore.prototype) as never)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(VisionBridge, { baseURL: OPTIONS.baseURL, apiKey: 'secret' })
+    const adapter = new TextOnlyAdapter([textResponse('first'), textResponse('second')])
+    ctx.llm.registerAdapter(['text-only'], adapter)
+    const agent = ctx.agentLoop.create(SessionId('vision-reminder'), { provider: 'text-only', model: 'plain' })
+
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: '看看这张图' }, { type: 'image', attachment: REF }],
+      source: { kind: 'user' },
+    }))
+    await waitForIdle(ctx, agent)
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: '继续' }], source: { kind: 'user' } }))
+    await waitForIdle(ctx, agent)
+
+    const reminders = agent.session.events.filter((event): event is SessionEvent<'user/message'> =>
+      event.type === 'user/message'
+      && event.data.source.kind === 'plugin'
+      && event.data.source.plugin === VisionBridge.name)
+    expect(reminders).toHaveLength(1)
+    const reminderBlock = reminders[0]?.data.content[0]
+    expect(reminderBlock?.type).toBe('text')
+    expect(reminderBlock?.type === 'text' ? reminderBlock.text : '').toContain(ID)
+    expect(adapter.requests).toHaveLength(2)
+    for (const request of adapter.requests) {
+      expect(request.messages.flatMap(message => message.content).some(block => block.type === 'image')).toBe(false)
+    }
+    const firstText = adapter.requests[0]?.messages
+      .flatMap(message => message.content)
+      .map(block => block.type === 'text' ? block.text : '')
+      .join('\n') ?? ''
+    const secondText = adapter.requests[1]?.messages
+      .flatMap(message => message.content)
+      .map(block => block.type === 'text' ? block.text : '')
+      .join('\n') ?? ''
+    expect(firstText).toContain(ID)
+    expect(secondText.indexOf(firstText)).toBe(0)
+    await ctx.fiber.dispose()
+  })
+})
+
+describe('vision_inspect', () => {
+  function eventWithImage(): SessionEvent {
+    return {
+      type: 'user/message',
+      seq: 1,
+      at: 1,
+      data: createUserMessage({ content: [{ type: 'image', attachment: REF }], source: { kind: 'user' } }),
+      meta: { surfaceOp: 'append' },
+    } as unknown as SessionEvent
+  }
+
+  function execution(events: readonly SessionEvent[]) {
+    return {
+      signal: new AbortController().signal,
+      agent: { session: { events } },
+    } as never
+  }
+
+  it('authorizes the complete batch from the current session before sending image bytes', async () => {
+    const readImage = vi.fn().mockResolvedValue({ ref: REF, data: Uint8Array.of(1) })
+    const ctx = { attachments: { readImage }, get: () => undefined } as unknown as Context
+    const fetchImpl = vi.fn(async (input: string | URL | Request, init?: RequestInit) => {
+      expect(input).toBe('http://vision.test/v1/chat/completions')
+      if (typeof init?.body !== 'string') throw new Error('expected a JSON string body')
+      const parsed = JSON.parse(init.body) as unknown
+      const body = parsed as {
+        model: string
+        chat_template_kwargs: { enable_thinking: boolean }
+        messages: Array<{ content: unknown }>
+      }
+      expect(body.model).toBe('qwen-vision')
+      expect(body.chat_template_kwargs).toEqual({ enable_thinking: false })
+      expect(JSON.stringify(body.messages[1]?.content)).toContain('data:image/png;base64,AQ==')
+      expect((init?.headers as Record<string, string>).authorization).toBe('Bearer secret')
+      return new Response(JSON.stringify({
+        choices: [{ message: { content: JSON.stringify({
+          summary: '一张界面截图',
+          observations: [{ text: '右上角有关闭按钮', region: '右上角', confidence: 0.9 }],
+          limitations: [],
+          model: 'must-not-leak',
+          createdAt: 'must-not-leak',
+        }) } }],
+      }), { status: 200, headers: { 'content-type': 'application/json' } })
+    })
+    const tool = VisionBridge.createVisionInspectTool(ctx, OPTIONS, fetchImpl)
+    const result = await tool.execute({ attachmentIds: [ID], prompt: '检查按钮' }, execution([eventWithImage()]))
+    expect(result).toEqual({
+      attachmentIds: [ID],
+      summary: '一张界面截图',
+      observations: [{ text: '右上角有关闭按钮', region: '右上角', confidence: 0.9 }],
+      limitations: [],
+    })
+    expect(readImage).toHaveBeenCalledOnce()
+    expect(fetchImpl).toHaveBeenCalledOnce()
+
+    await expect(tool.execute(
+      { attachmentIds: [`sha256:${'2'.repeat(64)}`], prompt: '偷看其他会话' },
+      execution([eventWithImage()]),
+    )).rejects.toThrow(/not available in the current session/)
+    expect(readImage).toHaveBeenCalledOnce()
+    expect(fetchImpl).toHaveBeenCalledOnce()
+  })
+
+  it('falls back safely when the visual model returns unstructured text', () => {
+    expect(VisionBridge.parseVisionResult('plain observation', [ID])).toEqual({
+      attachmentIds: [ID],
+      summary: 'plain observation',
+      observations: [],
+      limitations: ['视觉模型未返回约定的结构化 JSON；summary 保留了原始文本。'],
+    })
+  })
+
+  it('does not expose endpoint configuration in the output contract', () => {
+    const ctx = { attachments: {}, get: () => undefined } as unknown as Context
+    const tool = VisionBridge.createVisionInspectTool(ctx, OPTIONS, vi.fn())
+    const schema = JSON.stringify(tool.output.schema)
+    expect(schema).not.toContain('model')
+    expect(schema).not.toContain('createdAt')
+    expect(schema).not.toContain('baseURL')
+    expect(schema).not.toContain('apiKey')
+  })
+})
