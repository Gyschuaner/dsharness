+/** Stable wire name shared by the Host tool and its optional browser presentation. */
+export const VISION_INSPECT_TOOL_NAME = 'vision_inspect'
diff --git a/packages/vision/vision-bridge/tests/vision-inspect-row.client.spec.tsx b/packages/vision/vision-bridge/tests/vision-inspect-row.client.spec.tsx
new file mode 100644
index 0000000..640bc3c
--- /dev/null
+++ b/packages/vision/vision-bridge/tests/vision-inspect-row.client.spec.tsx
@@ -0,0 +1,148 @@
+// @vitest-environment jsdom
+// Dedicated visual Tool presentation: identity, Think-shaped activity,
+// replay-stable disclosure, lifecycle semantics, and keyed-slot ownership.
+
+import { Context } from '@deepseek-ai/cordis'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-runtime/client'
+import type { RunningToolCall, ToolResultNode } from '@deepseek-ai/dsh-client-runtime/client'
+import { ToolActivityChrome } from '@deepseek-ai/dsh-client-ui-tool/src/client/tool/components/ToolActivityChrome.tsx'
+import { apply, inject } from '../src/client/index.ts'
+import { VisionInspectRow } from '../src/client/VisionInspectRow.tsx'
+
+type RowProps = Parameters<typeof VisionInspectRow>[0]
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+})
+
+function running(argsRaw = '{"attachmentIds":["sha256:a"],"prompt":"Read the flowchart labels"}'): RunningToolCall {
+  return {
+    callId: 'call-vision', name: 'vision_inspect', argsRaw,
+    turn: 1, step: 1, time: 8_000, callView: null, subCalls: [],
+  }
+}
+
+function settled(over: Partial<ToolResultNode> = {}): ToolResultNode {
+  return {
+    kind: 'tool-result', seq: 3, time: 10_000, callId: 'call-vision',
+    call: {
+      name: 'vision_inspect',
+      argsRaw: '{"attachmentIds":["sha256:a"],"prompt":"Read the flowchart labels"}',
+    },
+    callTime: 8_000,
+    content: [{ type: 'text', text: '{"summary":"The node says request enters"}' }],
+    isError: false, callView: null, resultView: null, subCalls: [],
+    ...over,
+  }
+}
+
+function props(block: RowProps['block'], activityState?: RowProps['activityState']): RowProps {
+  return {
+    callId: block.callId,
+    toolName: 'vision_inspect',
+    block,
+    activityState,
+    openFile: vi.fn(),
+  } as unknown as RowProps
+}
+
+describe('VisionInspectRow', () => {
+  it('replaces generic Tool call copy with the viewfinder-eye Vision identity', () => {
+    const view = render(<VisionInspectRow {...props(running())} />)
+    expect(view.container.textContent).toContain('Visioning')
+    expect(view.container.textContent).toContain('Read the flowchart labels')
+    expect(view.container.textContent).not.toContain('Tool call')
+    const icon = view.container.querySelector('[data-icon="vision-inspect"]')
+    expect(icon?.getAttribute('viewBox')).toBe('0 0 14 14')
+    expect(icon?.querySelector('circle')).not.toBeNull()
+  })
+
+  it('composes the same ElapsedTime countdown used by Think', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(9_300)
+    const view = render(
+      <div>
+        <VisionInspectRow {...props(running(), 'running')} />
+        <ToolActivityChrome startedTime={8_000} state="running" />
+      </div>,
+    )
+    expect(view.container.textContent).toContain('Visioning')
+    expect(view.container.textContent).toContain('1s')
+    expect(view.container.querySelector('[data-tool-timer]')).not.toBeNull()
+  })
+
+  it('discloses exact durable input/output and preserves Inspect', () => {
+    const inspect = vi.fn()
+    render(<VisionInspectRow {...props(settled())} inspect={inspect} />)
+    const row = screen.getByRole('button', { name: /VisionRead the flowchart labels/ })
+    expect(row.getAttribute('aria-expanded')).toBe('false')
+    fireEvent.click(row)
+    expect(row.getAttribute('aria-expanded')).toBe('true')
+    expect(screen.getByText('IN')).toBeTruthy()
+    expect(screen.getByText('OUT')).toBeTruthy()
+    expect(screen.getByText(/sha256:a/)).toBeTruthy()
+    expect(screen.getByText(/request enters/)).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Inspect' }))
+    expect(inspect).toHaveBeenCalledTimes(1)
+  })
+
+  it('uses durable error and interrupted lifecycle semantics', () => {
+    const failed = render(<VisionInspectRow {...props(settled({
+      content: [{ type: 'text', text: 'VisionError: gateway unavailable\nRetry later.' }],
+      isError: true,
+      error: { name: 'VisionError', code: 'gateway' },
+    }))} />)
+    expect(failed.container.querySelector('[data-state="error"]')).not.toBeNull()
+    expect(failed.container.textContent).toContain('Vision inspection failed')
+    expect(screen.getByRole('button').textContent).not.toContain('Retry later')
+    cleanup()
+
+    const stopped = render(<VisionInspectRow {...props(settled({
+      content: [],
+      error: { name: 'InterruptedError', code: 'interrupted' },
+    }))} />)
+    expect(stopped.container.querySelector('[data-state="stopped"]')).not.toBeNull()
+    expect(stopped.container.textContent).toContain('Vision inspection stopped')
+  })
+
+  it('falls back safely for streamed or missing arguments', () => {
+    const partial = render(<VisionInspectRow {...props(running('{"prompt":"Inspect\n'))} />)
+    expect(partial.container.textContent).toContain('{"prompt":"Inspect')
+    cleanup()
+    const missing = render(<VisionInspectRow {...props(settled({ call: null, content: [] }))} />)
+    expect(missing.container.textContent).toContain('call-vision')
+    cleanup()
+    const emptyPrompt = render(<VisionInspectRow {...props(running('{"prompt":""}'))} />)
+    expect(emptyPrompt.container.textContent).toContain('{"prompt":""}')
+    cleanup()
+    const nonStringPrompt = render(<VisionInspectRow {...props(running('{"prompt":7}'))} />)
+    expect(nonStringPrompt.container.textContent).toContain('{"prompt":7}')
+    cleanup()
+    const structured = render(<VisionInspectRow {...props(settled({
+      content: [{ type: 'reasoning', text: 'visual trace' }],
+    }))} />)
+    fireEvent.click(screen.getByRole('button'))
+    expect(structured.container.textContent).toContain('"type": "reasoning"')
+  })
+})
+
+describe('browser plugin', () => {
+  it('owns only the vision_inspect keyed seat and releases it on disposal', async () => {
+    const ctx = new Context()
+    const slots = new SlotRegistry(ctx)
+    slots.register({
+      name: 'root',
+      children: { 'tool.call.toolview': { kind: 'keyed', scope: 'session' } },
+    } as never, () => null)
+    const fiber = ctx.plugin({ inject: [...inject], apply })
+    await fiber.await()
+    const entry = slots.entries('tool.call.toolview')[0]
+    expect(entry?.options).toMatchObject({ key: 'vision_inspect' })
+    expect(entry?.component).toBe(VisionInspectRow)
+    await fiber.dispose()
+    expect(slots.entries('tool.call.toolview')).toHaveLength(0)
+  })
+})
