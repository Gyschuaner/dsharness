+/* Dedicated visual Tool row. Geometry and activity motion intentionally match Think. */
+
+.root {
+  display: flex;
+  flex-direction: column;
+}
+
+.row {
+  position: relative;
+  overflow: hidden;
+}
+
+.root[data-state='running'] .row::after {
+  content: '';
+  position: absolute;
+  inset-block: 0;
+  left: 0;
+  width: 300px;
+  background: linear-gradient(
+    90deg,
+    transparent 0%,
+    color-mix(in srgb, var(--dsw-alias-bg-base) 60%, transparent) 55%,
+    transparent 100%
+  );
+  animation: dsh-vision-row-sweep 2.6s ease-out infinite;
+  pointer-events: none;
+}
+
+@keyframes dsh-vision-row-sweep {
+  0% { left: -300px; }
+  90%, 100% { left: 100%; }
+}
+
+.leading {
+  flex-shrink: 0;
+}
+
+.chevron {
+  color: var(--dsw-alias-label-secondary);
+}
+
+.title {
+  font-weight: 400;
+}
+
+.runningStatus {
+  flex: none;
+  margin-left: 5px;
+  color: var(--dsw-alias-label-caption);
+  font-size: 14px;
+  line-height: 24px;
+}
+
+.separator {
+  flex: none;
+  width: 2px;
+  height: 2px;
+  margin: 0 8px;
+  border-radius: 1px;
+  background: var(--dsw-alias-label-caption);
+}
+
+.summary {
+  min-width: 0;
+  overflow: hidden;
+  flex: 1 1 auto;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 14px;
+  line-height: 24px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.errorSummary {
+  color: var(--dsw-alias-state-error-primary);
+}
+
+.bodyWrap {
+  display: flex;
+  flex-direction: column;
+}
+
+.ioCard {
+  display: flex;
+  flex-direction: column;
+  max-height: 260px;
+  margin: 4px 0 4px 4px;
+  overflow: hidden;
+  border: 1px solid var(--dsw-alias-border-l1);
+  border-radius: 12px;
+  background: var(--dsw-alias-markdown-code-block);
+  font: var(--dsw-font-markdown-code-block-small);
+}
+
+.ioSection {
+  display: grid;
+  grid-template-columns: max-content minmax(0, 1fr);
+  column-gap: 14px;
+  align-items: baseline;
+  min-height: 0;
+  padding: 10px 12px;
+  overflow: auto;
+}
+
+.ioLabel {
+  color: var(--dsw-alias-label-caption);
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+}
+
+.ioText {
+  min-width: 0;
+  margin: 0;
+  color: var(--dsw-alias-label-secondary);
+  font: inherit;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.ioText[data-error] {
+  color: var(--dsw-alias-state-error-primary);
+}
+
+.ioDivider {
+  height: 1px;
+  background: var(--dsw-alias-border-l2);
+}
+
+.inspectButton {
+  display: inline-flex;
+  align-self: flex-start;
+  align-items: center;
+  gap: 4px;
+  margin: 4px 0 2px 4px;
+  padding: 2px 8px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 999px;
+  background: var(--dsw-alias-bg-base);
+  color: var(--dsw-alias-label-secondary);
+  font-size: 11px;
+  line-height: 16px;
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity 100ms ease;
+}
+
+.root:hover .inspectButton,
+.inspectButton:focus-visible {
+  opacity: 1;
+}
+
+.inspectButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover-solid);
+  color: var(--dsw-alias-label-primary);
+}
+
+.visuallyHidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .root[data-state='running'] .row::after {
+    animation: none;
+  }
+
+  .inspectButton {
+    transition: none;
+  }
+}
diff --git a/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
new file mode 100644
index 0000000..da89b5f
--- /dev/null
+++ b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
@@ -0,0 +1,141 @@
+/** Dedicated `vision_inspect` presentation: visual identity plus replay-stable evidence disclosure. */
+import { useState, type ReactNode } from 'react'
+import {
+  DisclosureRow, IconInspectOutline12, StateDot,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ToolCallViewProps } from '@deepseek-ai/dsh-client-ui-tool/client'
+import { VisionInspectIcon } from './VisionInspectIcon.tsx'
+import css from './VisionInspectRow.module.css'
+
+type VisionState = 'running' | 'ok' | 'error' | 'stopped'
+
+interface VisionModel {
+  readonly argsRaw: string
+  readonly output: string | null
+  readonly summary: string
+  readonly state: VisionState
+}
+
+function firstLine(text: string): string {
+  const newline = text.indexOf('\n')
+  return newline === -1 ? text : text.slice(0, newline)
+}
+
+function resultText(block: ToolCallViewProps['block']): string | null {
+  if (!('kind' in block)) return null
+  const parts = block.content.map(item => item.type === 'text' ? item.text : JSON.stringify(item, null, 2))
+  if (parts.length === 0 && block.error !== undefined) parts.push(`${block.error.name}: ${block.error.code}`)
+  return parts.join('\n') || null
+}
+
+function promptSummary(argsRaw: string, callId: string): string {
+  try {
+    const parsed = JSON.parse(argsRaw) as unknown
+    if (typeof parsed === 'object' && parsed !== null) {
+      const prompt = (parsed as Record<string, unknown>).prompt
+      if (typeof prompt === 'string' && prompt.trim() !== '') return firstLine(prompt.trim())
+    }
+  } catch {
+    // Streaming arguments may be an incomplete JSON prefix.
+  }
+  return argsRaw === '' ? callId : firstLine(argsRaw)
+}
+
+function visionModel(block: ToolCallViewProps['block']): VisionModel {
+  const settled = 'kind' in block
+  const argsRaw = (settled ? block.call?.argsRaw : block.argsRaw) ?? ''
+  const output = resultText(block)
+  const state: VisionState = !settled
+    ? 'running'
+    : block.error?.code === 'interrupted'
+      ? 'stopped'
+      : block.isError ? 'error' : 'ok'
+  return {
+    argsRaw,
+    output,
+    summary: state === 'error' && output !== null ? firstLine(output) : promptSummary(argsRaw, block.callId),
+    state,
+  }
+}
+
+function leadingFor(state: VisionState): ReactNode {
+  switch (state) {
+    case 'error': return <StateDot state="error" />
+    case 'stopped': return <StateDot state="warning" />
+    default: return <VisionInspectIcon />
+  }
+}
+
+function accessibleState(state: VisionState): string | null {
+  switch (state) {
+    case 'running': return 'Vision inspection running'
+    case 'error': return 'Vision inspection failed'
+    case 'stopped': return 'Vision inspection stopped'
+    default: return null
+  }
+}
+
+/** Render a visual inspection with a domain icon and Think-shaped activity title. */
+export function VisionInspectRow({ block, activityState, inspect }: ToolCallViewProps) {
+  const model = visionModel(block)
+  const [expanded, setExpanded] = useState(false)
+  const presentingRunning = activityState === undefined
+    ? model.state === 'running'
+    : activityState === 'running'
+  const expandable = model.output !== null || model.argsRaw !== ''
+  const open = expanded && expandable
+  const status = accessibleState(model.state)
+  return (
+    <div className={css.root} data-tool="vision_inspect" data-state={model.state}>
+      {status !== null && <span className={css.visuallyHidden}>{status}</span>}
+      <DisclosureRow
+        rowClassName={css.row}
+        leadingClassName={css.leading}
+        titleClassName={css.title}
+        chevronClassName={css.chevron}
+        icon={leadingFor(model.state)}
+        title="Vision"
+        titleSuffix={presentingRunning ? (
+          <span className={css.runningStatus} data-tool-running-status aria-hidden>ing</span>
+        ) : undefined}
+        open={open}
+        expandable={expandable}
+        expandOnRowClick
+        keepContentWhenOpen
+        onToggle={() => { setExpanded(value => !value) }}
+        collapsedContent={(
+          <>
+            <span className={css.separator} aria-hidden />
+            <span className={model.state === 'error' ? `${css.summary} ${css.errorSummary}` : css.summary}>
+              {model.summary}
+            </span>
+          </>
+        )}
+      >
+        <div className={css.bodyWrap}>
+          <div className={css.ioCard}>
+            {model.argsRaw !== '' && (
+              <section className={css.ioSection}>
+                <span className={css.ioLabel}>IN</span>
+                <pre className={css.ioText}>{model.argsRaw}</pre>
+              </section>
+            )}
+            {model.argsRaw !== '' && model.output !== null && <span className={css.ioDivider} aria-hidden />}
+            {model.output !== null && (
+              <section className={css.ioSection}>
+                <span className={css.ioLabel}>OUT</span>
+                <pre className={css.ioText} data-error={model.state === 'error' || undefined}>{model.output}</pre>
+              </section>
+            )}
+          </div>
+          {inspect !== undefined && (
+            <button type="button" className={css.inspectButton} onClick={inspect}>
+              <IconInspectOutline12 />
+              Inspect
+            </button>
+          )}
+        </div>
+      </DisclosureRow>
+    </div>
+  )
+}
