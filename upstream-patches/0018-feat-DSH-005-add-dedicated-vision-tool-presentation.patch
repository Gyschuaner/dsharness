+/** Browser half: opt-in keyed presentation for the Host-owned visual Tool. */
+import type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'
+import type {} from '@deepseek-ai/dsh-client-ui-tool/client'
+import { VISION_INSPECT_TOOL_NAME } from '../tool-name.ts'
+import { VisionInspectRow } from './VisionInspectRow.tsx'
+
+export const inject = ['slots']
+
+/** Register the visual Tool row; the plugin fiber owns teardown and HMR disposal. */
+export function apply(ctx: ClientContext): void {
+  ctx.slots.inject('tool.call.toolview', () => ctx.slots.register(
+    { name: 'tool.call.toolview', key: VISION_INSPECT_TOOL_NAME },
+    VisionInspectRow,
+  ))
+}
