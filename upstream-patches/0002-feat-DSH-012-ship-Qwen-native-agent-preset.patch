+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { join, resolve } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { discoverPresets } from '@deepseek-ai/dsh-agent-presets'
+
+const CLI_ROOT = resolve(fileURLToPath(new URL('../package.json', import.meta.url)), '..')
+const PRESET_ROOT = join(CLI_ROOT, 'config', 'agent-presets')
+const STANDARD = join(PRESET_ROOT, 'standard', 'agent.cordis.yml')
+const QWEN_NATIVE = join(PRESET_ROOT, 'qwen-native', 'agent.cordis.yml')
+const WEB_APP_PATCH = resolve(CLI_ROOT, '..', '..', 'packages', 'bundle', 'web-app', 'cordis.patch.yml')
+
+const PERSONA_BLOCK = /- id: persona\n[\s\S]*?(?=\n- id: agent-instructions)/
+const PRESET_HEADER = /^# The `[^`]+` agent preset:.*$/m
+
+function withoutPersona(composition: string): string {
+  const normalized = composition
+    .replace(PRESET_HEADER, '# preset header intentionally elided')
+    .replace(PERSONA_BLOCK, '- id: persona\n  # persona intentionally elided')
+  if (normalized === composition) throw new Error('composition has no persona block')
+  return normalized
+}
+
+describe('shipped qwen-native preset', () => {
+  it('is a healthy localized system preset', async () => {
+    const presets = await discoverPresets([{ path: PRESET_ROOT, trust: 'system' }])
+    const qwen = presets.find(preset => preset.id === 'qwen-native')
+
+    expect(qwen).toMatchObject({
+      id: 'qwen-native',
+      trust: 'system',
+      name: 'Qwen 原生模式',
+      description: '基于标准模式，为 Qwen3.8 优化行为提示；保留 DSH 原生工具、权限、Skills、计划、目标、子代理和工作流能力。',
+    })
+    expect(qwen?.broken).toBeUndefined()
+  })
+
+  it('changes only the standard persona while preserving every capability row', () => {
+    const standard = readFileSync(STANDARD, 'utf8')
+    const qwen = readFileSync(QWEN_NATIVE, 'utf8')
+
+    expect(withoutPersona(qwen)).toBe(withoutPersona(standard))
+    expect(qwen).toContain('You are Qwen')
+    expect(qwen).toContain('{{model}}')
+    expect(qwen).toContain('{{cwd}}')
+  })
+
+  it('does not change the deployment default away from standard', () => {
+    const webAppPatch = readFileSync(WEB_APP_PATCH, 'utf8')
+
+    expect(webAppPatch).toMatch(/id: agent-presets[\s\S]*?default: standard/)
+  })
+})
