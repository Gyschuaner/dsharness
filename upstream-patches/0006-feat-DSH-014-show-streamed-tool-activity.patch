+// @vitest-environment jsdom
+/** Streamed Tool row and elapsed-time chrome behavior. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import type { ConversationSnapshot } from '@deepseek-ai/dsh-client-runtime/client'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh } from '@deepseek-ai/dsh-client-ui-conversation/src/client/locales.ts'
+import type { ToolActivityProps } from '../src/client/contract/slots.ts'
+import { ToolActivityView } from '../src/client/tool/ToolActivityView.tsx'
+import { ToolActivityChrome } from '../src/client/tool/components/ToolActivityChrome.tsx'
+
+const t: ToolActivityProps['t'] = makeTranslate(zh, commonZh)
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.setSystemTime(10_000)
+})
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+})
+
+function props(): ToolActivityProps {
+  const snapshot = {} as ConversationSnapshot
+  const useSession = ((selector: (value: ConversationSnapshot) => unknown) => selector(snapshot)) as ToolActivityProps['useSession']
+  return {
+    useSession,
+    node: {
+      key: 'tool-activity:1:1',
+      kind: 'tool-activity',
+      id: '1:1',
+      target: 'chat',
+      anchorSeq: 3,
+      location: { kind: 'session' },
+      visibility: 'visible',
+      data: {
+        calls: [{
+          key: '1:1:0', callId: 'call-1', name: 'edit', seq: 3, time: 8_000,
+        }],
+      },
+    },
+    selectedCallId: undefined,
+    openFile: vi.fn(),
+    inspectCall: vi.fn(),
+    forkAt: vi.fn(),
+    loadImage: vi.fn(),
+    fileMentions: vi.fn(),
+    t,
+  } as unknown as ToolActivityProps
+}
+
+describe('streamed Tool activity', () => {
+  it('renders an ordinary running Tool row without exposing incomplete arguments', () => {
+    const view = render(<ToolActivityView {...props()} />)
+    const activity = view.container.querySelector('[data-tool-activity]')
+    expect(activity?.querySelector('[data-tool="edit"][data-state="running"]')).not.toBeNull()
+    expect(view.getByText('Edit')).toBeTruthy()
+    expect(view.getByText('2s')).toBeTruthy()
+    expect(view.getByText('ing')).toBeTruthy()
+    expect(activity?.textContent).not.toContain('{')
+  })
+
+  it('ticks while running and freezes with a hover-only Done token when settled', () => {
+    const view = render(<ToolActivityChrome startedTime={8_000} />)
+    expect(view.getByText('2s')).toBeTruthy()
+    act(() => { vi.advanceTimersByTime(1_000) })
+    expect(view.getByText('3s')).toBeTruthy()
+
+    view.rerender(<ToolActivityChrome startedTime={8_000} finishedTime={11_500} />)
+    expect(view.getByText('3s')).toBeTruthy()
+    expect(view.getByText('Done')).toBeTruthy()
+    expect(view.container.querySelector('[data-tool-activity-state="settled"]')).not.toBeNull()
+    act(() => { vi.advanceTimersByTime(5_000) })
+    expect(view.getByText('3s')).toBeTruthy()
+  })
+})
