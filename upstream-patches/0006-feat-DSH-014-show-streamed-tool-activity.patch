diff --git a/packages/client/ui-conversation/src/client/conversation-nodes/tool-activity.ts b/packages/client/ui-conversation/src/client/conversation-nodes/tool-activity.ts
new file mode 100644
index 0000000..0ab9fc7
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/conversation-nodes/tool-activity.ts
@@ -0,0 +1,166 @@
+import type { Context } from '@deepseek-ai/cordis'
+import type {
+  ConversationMatch, ConversationNodeDefinition,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { isAppendSurfaceEvent } from '@deepseek-ai/dsh-client-runtime/client'
+import type { PendingToolActivity, ToolActivityChatData } from '../contract/chat-nodes.ts'
+import { CHAT_SYNTHETIC_SEQ_OFFSETS, chatNode } from './common.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface ChatNodeDataMap {
+    /** Tool calls visible from their first streamed argument delta. */
+    'tool-activity': ToolActivityChatData
+  }
+}
+
+/** First streamed boundary retained for the formal Tool lifecycle. */
+export interface ToolActivityStart {
+  readonly seq: number
+  readonly time: number
+}
+
+/** Per-step streamed Tool state read by the later formal Tool Definition. */
+export interface ToolActivityState {
+  readonly turn: number
+  readonly step: number
+  readonly pending: ReadonlyMap<number, PendingToolActivity>
+  readonly starts: ReadonlyMap<string, ToolActivityStart>
+  /** Latest finalized Assistant or formal call boundary preceding pending rows. */
+  readonly placementSeq: number | undefined
+}
+
+function initialState(turn: number, step: number): ToolActivityState {
+  return { turn, step, pending: new Map(), starts: new Map(), placementSeq: undefined }
+}
+
+function rememberStart(
+  starts: ReadonlyMap<string, ToolActivityStart>,
+  callId: string,
+  value: ToolActivityStart,
+): ReadonlyMap<string, ToolActivityStart> {
+  if (callId === '' || starts.has(callId)) return starts
+  const next = new Map(starts)
+  next.set(callId, value)
+  return next
+}
+
+function updateDelta(state: ToolActivityState, match: ConversationMatch): ToolActivityState {
+  if (match.event.type !== 'assistant/chunk' || match.event.data.chunk.type !== 'tool-call-delta') return state
+  const chunk = match.event.data.chunk
+  const previous = state.pending.get(chunk.index)
+  const callId = previous?.callId || String(chunk.id)
+  const name = chunk.name ?? previous?.name ?? ''
+  let activity = previous
+  if (activity === undefined) {
+    activity = {
+      key: `${state.turn}:${state.step}:${chunk.index}`,
+      callId,
+      name,
+      seq: match.event.seq,
+      time: match.event.time,
+    }
+  } else if (activity.callId !== callId || activity.name !== name) {
+    activity = { ...activity, callId, name }
+  }
+  const pending = previous === activity ? state.pending : new Map(state.pending).set(chunk.index, activity)
+  const starts = rememberStart(state.starts, callId, { seq: activity.seq, time: activity.time })
+  return pending === state.pending && starts === state.starts ? state : { ...state, pending, starts }
+}
+
+function updateFinalMessage(state: ToolActivityState, match: ConversationMatch): ToolActivityState {
+  if (match.event.type !== 'assistant/message') return state
+  let pending: ReadonlyMap<number, PendingToolActivity> = state.pending
+  let starts = state.starts
+  for (const [index, activity] of state.pending) {
+    const block = match.event.data.message.content[index]
+    if (block?.type !== 'tool-call') continue
+    const callId = String(block.id)
+    const name = block.name
+    if (activity.callId !== callId || activity.name !== name) {
+      const next = new Map(pending)
+      next.set(index, { ...activity, callId, name })
+      pending = next
+    }
+    starts = rememberStart(starts, callId, { seq: activity.seq, time: activity.time })
+  }
+  return pending === state.pending && starts === state.starts
+    ? { ...state, placementSeq: match.event.seq }
+    : { ...state, pending, starts, placementSeq: match.event.seq }
+}
+
+function updateFormalCall(state: ToolActivityState, match: ConversationMatch): ToolActivityState {
+  if (match.event.type !== 'tool/call') return state
+  const callId = String(match.event.data.callId)
+  const name = match.event.data.name
+  const exact = [...state.pending].find(([, activity]) => activity.callId === callId)
+  // Providers may stream an empty id. The finalized Assistant normally fills
+  // it before this event; the name/oldest fallback keeps malformed histories
+  // from leaving a ghost row when that message is outside the loaded window.
+  const candidate = exact
+    ?? [...state.pending].find(([, activity]) => activity.callId === '' && activity.name === name)
+    ?? (state.pending.size === 1 ? [...state.pending][0] : undefined)
+  if (candidate === undefined) {
+    return state.pending.size === 0 ? state : { ...state, placementSeq: match.event.seq }
+  }
+  const [index, activity] = candidate
+  const pending = new Map(state.pending)
+  pending.delete(index)
+  const starts = rememberStart(state.starts, callId, { seq: activity.seq, time: activity.time })
+  return { ...state, pending, starts, placementSeq: match.event.seq }
+}
+
+function updateState(state: ToolActivityState, match: ConversationMatch): ToolActivityState {
+  if (match.event.type === 'assistant/chunk') return updateDelta(state, match)
+  if (match.event.type === 'assistant/message') return updateFinalMessage(state, match)
+  if (match.event.type === 'tool/call') return updateFormalCall(state, match)
+  if (match.event.type === 'llm/retry') {
+    return state.pending.size === 0 && state.starts.size === 0 && state.placementSeq === undefined
+      ? state
+      : { ...state, pending: new Map(), starts: new Map(), placementSeq: undefined }
+  }
+  if (match.event.type === 'step/end') {
+    return state.pending.size === 0 ? state : { ...state, pending: new Map() }
+  }
+  return state
+}
+
+/** Step-local streamed Tool activity, replaced by formal Tool nodes in place. */
+export const toolActivityDefinition: ConversationNodeDefinition<ToolActivityState> = {
+  kind: 'tool-activity',
+  target: 'chat',
+  match: (event) => {
+    if (event.type === 'step/start') return { id: `${event.data.turn}:${event.data.step}`, role: 'start' }
+    if (event.type === 'assistant/chunk' && event.data.chunk.type === 'tool-call-delta') {
+      return { id: `${event.data.turn}:${event.data.step}`, role: 'update' }
+    }
+    if ((event.type === 'assistant/message' && isAppendSurfaceEvent(event))
+      || event.type === 'tool/call'
+      || event.type === 'llm/retry'
+      || event.type === 'step/end') {
+      return { id: `${event.data.turn}:${event.data.step}`, role: 'update' }
+    }
+    return null
+  },
+  start: (_context, match) => {
+    if (match.event.type !== 'step/start') throw new Error('tool-activity start requires step/start')
+    return initialState(match.event.data.turn, match.event.data.step)
+  },
+  update: (context, match) => updateState(context.state, match),
+  publication: match => match.event.type === 'assistant/chunk' ? 'animation-frame' : 'immediate',
+  buildViewNode: (context) => {
+    const state = context.state
+    if (state === undefined) return null
+    const calls = [...state.pending.values()]
+    const anchor = state.placementSeq === undefined
+      ? calls[0]?.seq ?? context.start?.event.seq ?? 0
+      : state.placementSeq + CHAT_SYNTHETIC_SEQ_OFFSETS.finalizedFollowup
+    return chatNode(context, 'tool-activity', anchor, { calls }, {
+      visibility: calls.length === 0 ? 'hidden' : 'visible',
+    })
+  },
+}
+
+/** Register streamed Tool activity before the formal Tool lifecycle. */
+export function registerToolActivityConversationNode(ctx: Context): void {
+  ctx.conversationEvents.register(toolActivityDefinition)
+}
