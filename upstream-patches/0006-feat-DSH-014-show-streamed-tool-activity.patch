+import { useEffect, useState } from 'react'
+import css from './ToolActivityChrome.module.css'
+
+export interface ToolActivityChromeProps {
+  startedTime: number
+  finishedTime?: number | undefined
+}
+
+function formatElapsed(milliseconds: number): string {
+  const seconds = Math.max(0, Math.floor(milliseconds / 1_000))
+  if (seconds < 60) return `${seconds}s`
+  const minutes = Math.floor(seconds / 60)
+  return `${minutes}:${String(seconds % 60).padStart(2, '0')}`
+}
+
+/** Quiet elapsed-time chrome shared by streamed and formal Tool rows. */
+export function ToolActivityChrome({ startedTime, finishedTime }: ToolActivityChromeProps) {
+  const [now, setNow] = useState(() => Date.now())
+  const running = finishedTime === undefined
+  useEffect(() => {
+    if (!running) return undefined
+    const interval = globalThis.setInterval(() => { setNow(Date.now()) }, 250)
+    return () => { globalThis.clearInterval(interval) }
+  }, [running])
+  const elapsed = (finishedTime ?? now) - startedTime
+  return (
+    <span className={css.root} data-tool-activity-state={running ? 'running' : 'settled'} aria-hidden>
+      <span className={css.timer} data-tool-timer>{formatElapsed(elapsed)}</span>
+      <span className={css.status} data-tool-activity-status>
+        {running ? 'ing' : 'Done'}
+      </span>
+    </span>
+  )
+}
