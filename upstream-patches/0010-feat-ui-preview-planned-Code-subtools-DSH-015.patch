+++ b/packages/client/ui-conversation/tests/planned-tools.client.spec.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest'
+import { extractPlannedToolNames } from '../src/client/conversation-nodes/planned-tools.ts'
+
+describe('planned Code tools', () => {
+  it('streams completed declared names before code and preserves repetitions', () => {
+    expect(extractPlannedToolNames('{"plannedTools":["read","write","wri')).toEqual(['read', 'write'])
+    expect(extractPlannedToolNames('{"plannedTools":["read","read"],"code":""}')).toEqual(['read', 'read'])
+  })
+
+  it('treats a non-empty declaration as authoritative over source text', () => {
+    expect(extractPlannedToolNames(JSON.stringify({
+      plannedTools: ['write'],
+      code: 'await tools.read({ path: "a" }); await tools.write({ path: "b" })',
+    }))).toEqual(['write'])
+  })
+
+  it('falls back to direct dot and bracket calls for old or empty declarations', () => {
+    expect(extractPlannedToolNames(JSON.stringify({
+      code: 'await tools.read({}); await tools["my-tool"]({}); await tools.read({})',
+    }))).toEqual(['read', 'my-tool', 'read'])
+    expect(extractPlannedToolNames(JSON.stringify({
+      plannedTools: [],
+      code: 'await tools.write({})',
+    }))).toEqual(['write'])
+  })
+
+  it('ignores source examples, comments, and indirect references', () => {
+    const code = [
+      'const sample = "tools.write({})"',
+      '// tools.edit({})',
+      '/* tools.read({}) */',
+      '# tools.bash({})',
+      'const fn = tools.write',
+      'await tools.search({})',
+    ].join('\n')
+    expect(extractPlannedToolNames(JSON.stringify({ code }))).toEqual(['search'])
+  })
+})
