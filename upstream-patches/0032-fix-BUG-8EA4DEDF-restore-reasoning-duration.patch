+function finishReasoning(
+  timings: readonly (ReasoningTiming | undefined)[],
+  time: number,
+  exceptIndex?: number,
+): readonly (ReasoningTiming | undefined)[] {
+  let next: (ReasoningTiming | undefined)[] | undefined
+  for (let index = 0; index < timings.length; index++) {
+    const timing = timings[index]
+    if (index === exceptIndex || timing === undefined || timing.finishedTime !== undefined) continue
+    next ??= [...timings]
+    next[index] = { ...timing, finishedTime: time }
+  }
+  return next ?? timings
+}
+
+function startReasoning(
+  timings: readonly (ReasoningTiming | undefined)[],
+  index: number,
+  time: number,
+): readonly (ReasoningTiming | undefined)[] {
+  const closed = finishReasoning(timings, time, index)
+  if (closed[index] !== undefined) return closed
+  const next = [...closed]
+  next[index] = { startedTime: time }
+  return next
+}
+
 function compactBlocks(blocks: readonly (AssistantBlock | undefined)[]): AssistantBlock[] {
   return blocks.filter((block): block is AssistantBlock => block !== undefined)
 }
 
+function compactReasoningTimings(
+  blocks: readonly (AssistantBlock | undefined)[],
+  timings: readonly (ReasoningTiming | undefined)[],
+): readonly (ReasoningTiming | undefined)[] {
+  const compacted: (ReasoningTiming | undefined)[] = []
+  for (let index = 0; index < blocks.length; index++) {
+    if (blocks[index] !== undefined) compacted.push(timings[index])
+  }
+  return compacted
+}
