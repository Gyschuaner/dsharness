+const RETRY_CONTEXT_SOURCE = '@deepseek-ai/dsh-agent-loop/malformed-tool-call-retry'
+
+/**
+ * Append recovery guidance without changing the durable history or request header.
+ * Keeping the original messages as an exact prefix preserves provider prompt-cache reuse.
+ */
+export function appendMalformedToolCallRetryContext(messages: readonly Message[]): Message[] {
+  return [...messages, createUserMessage({
+    content: [{ type: 'text', text: MALFORMED_TOOL_CALL_RETRY_REMINDER }],
+    source: { kind: 'plugin', plugin: RETRY_CONTEXT_SOURCE },
+  })]
+}
+
+/**
+ * Accept only the package-owned, exact one-message suffix as a legal deviation
+ * from durable request reconstruction.
+ */
+export function isMalformedToolCallRetryContext(
+  messages: readonly Message[],
+  durableMessages: readonly Message[],
+): boolean {
+  if (messages.length !== durableMessages.length + 1) return false
+  if (JSON.stringify(messages.slice(0, -1)) !== JSON.stringify(durableMessages)) return false
+  // Invariant callers may hand us an intentionally malformed runtime value.
+  const tail = messages.at(-1) as Partial<Message> | undefined
+  if (tail?.role !== 'user' || tail.source?.kind !== 'plugin') return false
+  return Object.keys(tail).sort().join(',') === 'content,id,role,source'
+    && Object.keys(tail.source).sort().join(',') === 'kind,plugin'
+    && tail.source.plugin === RETRY_CONTEXT_SOURCE
+    && JSON.stringify(tail.content) === JSON.stringify([{
+      type: 'text', text: MALFORMED_TOOL_CALL_RETRY_REMINDER,
+    }])
+}
