+/** One-turn guidance used only after a model wrote a would-be tool call in reasoning. */
+const MALFORMED_TOOL_CALL_RETRY_REMINDER = `<system-reminder>
+Your previous attempt ended with private reasoning but no final answer or structured tool call. Retry the same task now.
+When a tool is needed, invoke it only through the native structured tool-call channel. Do not write tool-call XML, JSON, tags, or arguments in reasoning or visible text, and do not merely describe the call.
+If no tool is needed, continue reasoning or provide the final answer.
+</system-reminder>`
+
+/** Qwen-style markup observed in private reasoning instead of the native tool channel. */
+const TOOL_CALL_MARKUP = /<\s*\/?\s*tool_call\b|<\s*(?:function|parameter)\s*=/i
+
+/**
+ * Identify the narrow recoverable defect without interpreting its payload.
+ * Any visible answer or native output block wins, so quoted examples remain
+ * inert; the XML itself is never parsed or executed.
+ */
+function reasoningOnlyText(content: readonly ContentBlock[]): string | undefined {
+  let reasoning = ''
+  for (const block of content) {
+    if (block.type === 'reasoning') {
+      reasoning += block.text
+      continue
+    }
+    if (block.type === 'text' && block.text.trim().length === 0) continue
+    return undefined
+  }
+  return reasoning.trim().length > 0 ? reasoning : undefined
+}
