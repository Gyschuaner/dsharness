+/** Request-local recovery context for malformed reasoning tool calls. */
+
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { Message } from '@deepseek-ai/dsh-llm'
+
+/** One-request guidance used only after a model wrote a would-be tool call in reasoning. */
+export const MALFORMED_TOOL_CALL_RETRY_REMINDER = `<system-reminder>
+Your previous attempt ended with private reasoning but no final answer or structured tool call. Retry the same task now.
+When a tool is needed, invoke it only through the native structured tool-call channel. Do not write tool-call XML, JSON, tags, or arguments in reasoning or visible text, and do not merely describe the call.
+If no tool is needed, continue reasoning or provide the final answer.
