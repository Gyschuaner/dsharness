+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import { ElapsedTime, formatElapsedDuration } from '../src/ElapsedTime.tsx'
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.setSystemTime(10_000)
+})
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+})
+
+describe('ElapsedTime', () => {
+  it('formats milliseconds, seconds, and minute clocks without rounding up', () => {
+    expect(formatElapsedDuration(-1)).toBe('0ms')
+    expect(formatElapsedDuration(999.9)).toBe('999ms')
+    expect(formatElapsedDuration(1_000)).toBe('1s')
+    expect(formatElapsedDuration(59_999)).toBe('59s')
+    expect(formatElapsedDuration(60_000)).toBe('1:00')
+    expect(formatElapsedDuration(125_999)).toBe('2:05')
+  })
+
+  it('ticks while live and freezes at the supplied completion boundary', () => {
+    const view = render(<ElapsedTime className="quiet" startedTime={8_000} />)
+    expect(view.getByText('2s').className).toBe('quiet')
+    expect(view.container.querySelector('[data-elapsed-time]')).not.toBeNull()
+
+    act(() => { vi.advanceTimersByTime(1_000) })
+    expect(view.getByText('3s')).toBeTruthy()
+
+    view.rerender(<ElapsedTime startedTime={8_000} finishedTime={8_350} />)
+    expect(view.getByText('350ms')).toBeTruthy()
+    act(() => { vi.advanceTimersByTime(5_000) })
+    expect(view.getByText('350ms')).toBeTruthy()
+  })
+})
