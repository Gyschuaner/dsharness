+/**
+ * Automatic next-turn continuation after a conversation request reaches its
+ * output-token ceiling.
+ *
+ * @module @deepseek-ai/dsh-max-token-continuation
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+import type { Session, SessionEvent } from '@deepseek-ai/dsh-session'
+
+export const name = 'max-token-continuation'
+export const inject = ['agents']
+
+/** Source identity for every continuation message owned by this plugin. */
+export const MAX_TOKEN_CONTINUATION_SOURCE = '@deepseek-ai/dsh-max-token-continuation'
+
+/** Exact model-visible reminder retained after a max-token turn. */
+export const MAX_TOKEN_CONTINUATION_REMINDER = `<system-reminder>
+上一轮因输出 token 上限被截断，已有输出已保留，从停止的位置继续同一个任务。
+</system-reminder>`
+
+/**
+ * Create the durable next-turn message used for automatic continuation.
+ *
+ * @returns The exact plugin-owned system reminder as a durable user message.
+ */
+export function createMaxTokenContinuationReminder(): UserMessage {
+  return createUserMessage({
+    content: [{ type: 'text', text: MAX_TOKEN_CONTINUATION_REMINDER }],
+    source: { kind: 'plugin', plugin: MAX_TOKEN_CONTINUATION_SOURCE },
+  })
+}
+
+/** Install unlimited automatic continuation with pending-human takeover. */
+export function apply(ctx: Context): void {
+  const needed = new WeakSet<Agent>()
+
+  ctx.on('session/event', (session: Session, event: SessionEvent) => {
+    if (event.type !== 'turn/end' || event.data.reason.kind !== 'max-tokens') return
+    const agent = ctx.agents.get(session.id)
+    if (agent === undefined || agent.session !== session) return
+    // Session observers run inside append publication, where another durable
+    // inbox append would be rejected as reentrant. The idle transition is the
+    // first lifecycle point after publication closes.
+    needed.add(agent)
+  }, { global: true })
+
+  ctx.on('agent/status', ({ agent, status }) => {
+    if (status !== 'idle' || !needed.delete(agent)) return
+    if (ctx.agents.get(agent.id) !== agent || agent.inbox.nextTurn.length > 0) return
+    agent.followup(createMaxTokenContinuationReminder())
+  }, { global: true })
+}
