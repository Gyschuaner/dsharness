+
+import { isDeepStrictEqual } from 'node:util'
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantFailure, InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+import type { Session, SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  MAX_TOKEN_CONTINUATION_REMINDER,
+  MAX_TOKEN_CONTINUATION_SOURCE,
+} from './index.ts'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-max-token-continuation'
+
+/** Cordis companion plugin name. */
+export const name = 'max-token-continuation-invariant'
+/** Service required before the companion can reserve package ownership. */
+export const inject = ['invariants']
+
+/** Validate one package-owned reminder against its preceding turn. */
+function validateEvent(
+  prior: readonly SessionEvent[],
+  event: SessionEvent,
+  fail: InvariantFailure,
+): void {
+  if (event.type !== 'user/message') return
+  const source = event.data.source
+  if (source.kind !== 'plugin' || source.plugin !== MAX_TOKEN_CONTINUATION_SOURCE) return
+  if (!isDeepStrictEqual(event.data.content, [{ type: 'text', text: MAX_TOKEN_CONTINUATION_REMINDER }])) {
+    fail('continuation message does not match the package-owned reminder')
+  }
+  const turnEnd = prior.findLast(candidate => candidate.type === 'turn/end')
+  if (turnEnd?.data.reason.kind !== 'max-tokens') {
+    fail('continuation message is not preceded by a max-tokens turn')
+  }
+}
+
+/** Check existing sessions and every candidate event before Session publishes it. */
+const install: InvariantInstaller = Object.assign((ctx: Context, fail: InvariantFailure) => {
+  for (const session of ctx.sessions.list()) {
+    const prior: SessionEvent[] = []
+    for (const event of session.events) {
+      validateEvent(prior, event, fail)
+      prior.push(event)
+    }
+  }
+  /* jscpd:ignore-start -- package companions share dispatch and registration plumbing */
+  ctx.on('internal/dispatch', (_mode, eventName, args) => {
+    if (eventName !== 'session/event') return
+    const [session, event] = args as [Session, SessionEvent]
+    validateEvent(session.events, event, fail)
+  }, { global: true })
+}, { inject: ['sessions'] })
+
+/**
+ * Register the max-token-continuation invariant companion.
+ * @param ctx - Cordis context carrying the invariant service.
+ * @returns the installed registration's disposer after setup succeeds.
+ */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
+/* jscpd:ignore-end */
diff --git a/packages/guard/max-token-continuation/tests/max-token-continuation.spec.ts b/packages/guard/max-token-continuation/tests/max-token-continuation.spec.ts
new file mode 100644
index 0000000..68090cc
--- /dev/null
+++ b/packages/guard/max-token-continuation/tests/max-token-continuation.spec.ts
@@ -0,0 +1,132 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import * as MaxTokenContinuation from '@deepseek-ai/dsh-max-token-continuation'
+import {
+  MAX_TOKEN_CONTINUATION_REMINDER,
+  MAX_TOKEN_CONTINUATION_SOURCE,
+} from '@deepseek-ai/dsh-max-token-continuation'
+import {
+  maxTokensResponse,
+  MockAdapter,
+  textResponse,
+} from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+/** Boot the real agent loop and the host continuation plugin. */
+async function harness(): Promise<{ ctx: Context; plugin: { dispose(): Promise<void> } }> {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  const plugin = await ctx.plugin(MaxTokenContinuation)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  return { ctx, plugin }
+}
+
+/** Package-owned messages that reached durable model history. */
+function continuationMessages(agent: Agent): SessionEvent<'user/message'>[] {
+  return agent.session.events.filter((event): event is SessionEvent<'user/message'> =>
+    event.type === 'user/message'
+    && event.data.source.kind === 'plugin'
+    && event.data.source.plugin === MAX_TOKEN_CONTINUATION_SOURCE)
+}
+
+/** Start one human turn and wait for the complete replacement-work interval. */
+async function run(agent: Agent): Promise<void> {
+  agent.followup(createUserMessage({
+    content: [{ type: 'text', text: 'start' }],
+    source: { kind: 'user' },
+  }))
+  await agent.whenIdle()
+}
+
+describe('max-token continuation', () => {
+  it('continues without a round cap until a request completes normally', async () => {
+    const { ctx } = await harness()
+    const adapter = new MockAdapter([
+      maxTokensResponse('part one'),
+      maxTokensResponse('part two'),
+      maxTokensResponse('part three'),
+      textResponse('done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = ctx.agentLoop.create(SessionId('unlimited'), { provider: 'mock', model: 'mock' })
+
+    await run(agent)
+
+    expect(adapter.requests).toHaveLength(4)
+    expect(agent.session.events
+      .filter((event): event is SessionEvent<'turn/end'> => event.type === 'turn/end')
+      .map(event => event.data.reason.kind))
+      .toEqual(['max-tokens', 'max-tokens', 'max-tokens', 'completed'])
+    expect(continuationMessages(agent).map(event => event.data.content)).toEqual([
+      [{ type: 'text', text: MAX_TOKEN_CONTINUATION_REMINDER }],
+      [{ type: 'text', text: MAX_TOKEN_CONTINUATION_REMINDER }],
+      [{ type: 'text', text: MAX_TOKEN_CONTINUATION_REMINDER }],
+    ])
+  })
+
+  it('lets already queued human work own the next turn', async () => {
+    const { ctx } = await harness()
+    const adapter = new MockAdapter([
+      () => {
+        agent.followup(createUserMessage({
+          content: [{ type: 'text', text: 'take over' }],
+          source: { kind: 'user' },
+        }))
+        return maxTokensResponse('partial')
+      },
+      textResponse('human follow-up done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = ctx.agentLoop.create(SessionId('queued-human'), { provider: 'mock', model: 'mock' })
+
+    await run(agent)
+
+    expect(adapter.requests).toHaveLength(2)
+    expect(continuationMessages(agent)).toEqual([])
+    expect(agent.session.events
+      .filter((event): event is SessionEvent<'user/message'> => event.type === 'user/message')
+      .map(event => event.data.source.kind))
+      .toEqual(['user', 'user'])
+  })
+
+  it('stops automatic continuation when the next request fails', async () => {
+    const { ctx } = await harness()
+    const adapter = new MockAdapter([
+      maxTokensResponse('partial'),
+      () => { throw new Error('provider failed') },
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = ctx.agentLoop.create(SessionId('request-failure'), { provider: 'mock', model: 'mock' })
+
+    await run(agent)
+
+    expect(adapter.requests).toHaveLength(2)
+    expect(continuationMessages(agent)).toHaveLength(1)
+    expect(agent.session.events
+      .filter((event): event is SessionEvent<'turn/end'> => event.type === 'turn/end')
+      .map(event => event.data.reason.kind))
+      .toEqual(['max-tokens', 'error'])
+  })
+
+  it('removes its continuation behavior when the plugin fiber is disposed', async () => {
+    const { ctx, plugin } = await harness()
+    await plugin.dispose()
+    const adapter = new MockAdapter([maxTokensResponse('partial')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = ctx.agentLoop.create(SessionId('disposed-plugin'), { provider: 'mock', model: 'mock' })
+
+    await run(agent)
+
+    expect(adapter.requests).toHaveLength(1)
+    expect(continuationMessages(agent)).toEqual([])
+    expect(agent.session.events
+      .filter((event): event is SessionEvent<'turn/end'> => event.type === 'turn/end')
+      .map(event => event.data.reason.kind))
+      .toEqual(['max-tokens'])
+  })
+})
