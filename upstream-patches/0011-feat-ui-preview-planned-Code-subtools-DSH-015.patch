+/** Conservatively find direct tools.name(...) and tools["name"](...) source calls. */
+function staticToolCalls(source: string): string[] {
+  const names: string[] = []
+  let cursor = 0
+  while (cursor < source.length && names.length < MAX_PLANNED_TOOL_ROWS) {
+    const character = source[cursor]
+    if (character === '"' || character === "'" || character === '`') {
+      cursor = skipSourceString(source, cursor)
+      continue
+    }
+    if ((character === '/' && source[cursor + 1] === '/') || character === '#') {
+      const newline = source.indexOf('\n', cursor + 1)
+      cursor = newline < 0 ? source.length : newline + 1
+      continue
+    }
