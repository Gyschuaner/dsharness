+/** Incremental run_code argument inspection for provisional child Tool rows. */
+
+const MAX_PLANNED_TOOL_ROWS = 64
+
+interface PartialString {
+  readonly value: string
+  readonly end: number
+  readonly complete: boolean
+}
+
+/** Decode one complete or partial JSON string without accepting later properties as content. */
+function readJsonString(input: string, start: number): PartialString {
+  let value = ''
+  let cursor = start + 1
+  while (cursor < input.length) {
+    const character = input[cursor]
+    if (character === undefined) break
+    if (character === '"') return { value, end: cursor + 1, complete: true }
+    if (character !== '\\') {
+      value += character
+      cursor++
+      continue
+    }
+    const escaped = input[cursor + 1]
+    if (escaped === undefined) break
+    const simple: Record<string, string> = {
+      '"': '"', '\\': '\\', '/': '/', b: '\b', f: '\f', n: '\n', r: '\r', t: '\t',
+    }
+    if (escaped !== 'u') {
+      value += simple[escaped] ?? escaped
+      cursor += 2
+      continue
+    }
+    const digits = input.slice(cursor + 2, cursor + 6)
+    if (!/^[0-9a-fA-F]{4}$/.test(digits)) break
+    value += String.fromCharCode(Number.parseInt(digits, 16))
+    cursor += 6
+  }
+  return { value, end: input.length, complete: false }
+}
+
+/** Locate one top-level object property whose value starts with the requested token. */
+function topLevelPropertyValue(input: string, property: string, opening: '[' | '"'): number | undefined {
+  let depth = 0
+  let cursor = 0
+  while (cursor < input.length) {
+    const character = input[cursor]
+    if (character === '"') {
+      const parsed = readJsonString(input, cursor)
+      if (!parsed.complete) return undefined
+      if (depth === 1 && parsed.value === property) {
+        let valueCursor = parsed.end
+        while (/\s/.test(input[valueCursor] ?? '')) valueCursor++
+        if (input[valueCursor] !== ':') {
+          cursor = parsed.end
+          continue
+        }
+        valueCursor++
+        while (/\s/.test(input[valueCursor] ?? '')) valueCursor++
+        if (input[valueCursor] === opening) return valueCursor
+      }
+      cursor = parsed.end
+      continue
+    }
+    if (character === '{' || character === '[') depth++
+    else if (character === '}' || character === ']') depth--
+    cursor++
+  }
+  return undefined
+}
+
+/** Read completed string members from a possibly incomplete JSON array. */
+function partialStringArray(input: string, start: number): { values: string[]; complete: boolean } {
+  const values: string[] = []
+  let cursor = start + 1
+  while (cursor < input.length && values.length < MAX_PLANNED_TOOL_ROWS) {
+    while (/\s|,/.test(input[cursor] ?? '')) cursor++
+    if (input[cursor] === ']') return { values, complete: true }
+    if (input[cursor] !== '"') return { values, complete: false }
+    const parsed = readJsonString(input, cursor)
+    if (!parsed.complete) return { values, complete: false }
+    if (parsed.value.length > 0) values.push(parsed.value)
+    cursor = parsed.end
+  }
+  return { values, complete: false }
+}
+
+/** Skip one quoted source literal; incomplete literals consume the available prefix. */
+function skipSourceString(source: string, start: number): number {
+  const quote = source[start] ?? ''
+  const triple = (quote === '"' || quote === "'") && source.slice(start, start + 3) === quote.repeat(3)
+  const delimiter = triple ? quote.repeat(3) : quote
+  let cursor = start + delimiter.length
+  while (cursor < source.length) {
+    if (source[cursor] === '\\') {
+      cursor += 2
+      continue
+    }
+    if (source.slice(cursor, cursor + delimiter.length) === delimiter) return cursor + delimiter.length
+    cursor++
+  }
+  return source.length
+}
+
+/** Decode a completed single- or double-quoted source literal used as a bracket member. */
+function sourceString(source: string, start: number): PartialString {
+  const quote = source[start]
+  let value = ''
+  let cursor = start + 1
+  while (cursor < source.length) {
+    const character = source[cursor]
+    if (character === undefined) break
+    if (character === quote) return { value, end: cursor + 1, complete: true }
+    if (character === '\\') {
+      const escaped = source[cursor + 1]
+      if (escaped === undefined) break
+      value += escaped
+      cursor += 2
+      continue
+    }
+    value += character
+    cursor++
+  }
+  return { value, end: source.length, complete: false }
+}
+
+function identifierCharacter(character: string | undefined): boolean {
+  return character !== undefined && /[A-Za-z0-9_$]/.test(character)
+}
