+      memberCursor++
+      const nameStart = memberCursor
+      if (!/[A-Za-z_$]/.test(source[memberCursor] ?? '')) {
+        cursor += 5
+        continue
+      }
+      while (identifierCharacter(source[memberCursor])) memberCursor++
+      name = source.slice(nameStart, memberCursor)
+    } else if (source[memberCursor] === '[') {
+      memberCursor++
+      while (/\s/.test(source[memberCursor] ?? '')) memberCursor++
+      if (source[memberCursor] !== '"' && source[memberCursor] !== "'") {
+        cursor += 5
+        continue
+      }
+      const parsed = sourceString(source, memberCursor)
+      if (!parsed.complete) break
+      name = parsed.value
+      memberCursor = parsed.end
+      while (/\s/.test(source[memberCursor] ?? '')) memberCursor++
+      if (source[memberCursor] !== ']') {
+        cursor += 5
+        continue
+      }
+      memberCursor++
+    } else {
+      cursor += 5
+      continue
+    }
+    while (/\s/.test(source[memberCursor] ?? '')) memberCursor++
+    if (source[memberCursor] === '(' && name.length > 0) names.push(name)
+    cursor = Math.max(memberCursor + 1, cursor + 5)
+  }
+  return names
+}
+
+/**
+ * Extract ordered provisional child Tool names from streamed run_code JSON.
+ * A declared non-empty/incomplete `plannedTools` array is authoritative; old
+ * calls with no usable declaration fall back to conservative source scanning.
+ * @param argumentsRaw - complete or partial run_code JSON arguments.
+ * @returns ordered names, including repetitions, capped for bounded rendering.
+ */
+export function extractPlannedToolNames(argumentsRaw: string): readonly string[] {
+  const plannedStart = topLevelPropertyValue(argumentsRaw, 'plannedTools', '[')
+  if (plannedStart !== undefined) {
+    const planned = partialStringArray(argumentsRaw, plannedStart)
+    if (planned.values.length > 0 || !planned.complete) return planned.values
+  }
+  const codeStart = topLevelPropertyValue(argumentsRaw, 'code', '"')
+  if (codeStart === undefined) return []
+  return staticToolCalls(readJsonString(argumentsRaw, codeStart).value)
+}
