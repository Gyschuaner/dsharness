diff --git a/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
index e9d6a4f..c84a8e9 100644
--- a/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
+++ b/packages/vision/vision-bridge/src/client/VisionInspectRow.tsx
@@ -44,23 +44,59 @@ function partialJsonString(text: string, start: number): string {
   return value
 }
 
-/** Extract the leading structured summary even while its JSON string is incomplete. */
-function visualSummary(text: string): string {
+function structuredObject(text: string): Record<string, unknown> | null {
   const trimmed = text.trimStart().replace(/^```(?:json)?\s*/i, '')
   try {
     const parsed = JSON.parse(trimmed) as unknown
-    if (typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)) {
-      const summary = (parsed as Record<string, unknown>).summary
-      if (typeof summary === 'string') return summary.trim()
-    }
+    return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+      ? parsed as Record<string, unknown>
+      : null
   } catch {
     // A streaming JSON prefix is expected until the final fragment arrives.
+    return null
   }
+}
+
+/** Extract the leading structured summary even while its JSON string is incomplete. */
+function visualSummary(text: string): string {
+  const trimmed = text.trimStart().replace(/^```(?:json)?\s*/i, '')
+  const summary = structuredObject(text)?.summary
+  if (typeof summary === 'string') return summary.trim()
   const match = /"summary"\s*:\s*"/.exec(trimmed)
   if (match !== null) return partialJsonString(trimmed, match.index + match[0].length).trim()
   return trimmed.startsWith('{') ? '' : trimmed.trim()
 }
 
+/** Follow the latest observation once the stream advances past its summary. */
+function visualProgress(text: string): string {
+  const observations = structuredObject(text)?.observations
+  if (Array.isArray(observations)) {
+    for (let index = observations.length - 1; index >= 0; index -= 1) {
+      const observation: unknown = observations[index]
+      if (typeof observation !== 'object' || observation === null || Array.isArray(observation)) continue
+      const value = (observation as Record<string, unknown>).text
+      if (typeof value === 'string' && value.trim() !== '') return value.trim()
+    }
+  }
+
+  const trimmed = text.trimStart().replace(/^```(?:json)?\s*/i, '')
+  const observationsStart = /"observations"\s*:\s*\[/.exec(trimmed)
+  if (observationsStart !== null) {
+    const scopeStart = observationsStart.index + observationsStart[0].length
+    const scope = trimmed.slice(scopeStart)
+    const textPattern = /"text"\s*:\s*"/g
+    let latestStart = -1
+    for (let match = textPattern.exec(scope); match !== null; match = textPattern.exec(scope)) {
+      latestStart = match.index + match[0].length
+    }
+    if (latestStart >= 0) {
+      const observation = partialJsonString(scope, latestStart).trim()
+      if (observation !== '') return observation
+    }
+  }
+  return visualSummary(text)
+}
+
 function firstLine(text: string): string {
   const newline = text.indexOf('\n')
   return newline === -1 ? text : text.slice(0, newline)
