--- a/packages/client/ui-tool/src/client/tool/ToolCallTree.module.css
+++ b/packages/client/ui-tool/src/client/tool/ToolCallTree.module.css
@@ -15,6 +15,13 @@
   min-width: 0;
 }
 
+/* A keyed Tool view may own Think-shaped activity inside its title. In that
+   case the generic trailing duration/Done chrome would duplicate the same
+   lifecycle signal. */
+.callHead:has([data-tool-activity-placement='inline']) > [data-tool-activity-state] {
+  display: none;
+}
+
 /* The Think-style sweep belongs to the whole call seat, so built-in and
    package-contributed Tool views receive one identical in-flight signal. */
 .callHead[data-state='running']::after {
