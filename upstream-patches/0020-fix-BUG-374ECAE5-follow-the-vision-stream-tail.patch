diff --git a/packages/vision/vision-bridge/src/client/use-throttled-visual-update.ts b/packages/vision/vision-bridge/src/client/use-throttled-visual-update.ts
new file mode 100644
index 0000000..0f0b075
--- /dev/null
+++ b/packages/vision/vision-bridge/src/client/use-throttled-visual-update.ts
@@ -0,0 +1,32 @@
+/** Frame-throttled scheduling for the visual stream's non-essential DOM alignment. */
+import { useCallback, useLayoutEffect, useRef } from 'react'
+
+const INTERVAL_FRAMES = 3
+
+/** Coalesce streamed summary scrolling and apply only the latest alignment. */
+export function useThrottledVisualUpdate(update: () => void): () => void {
+  const updateRef = useRef(update)
+  updateRef.current = update
+  const pendingFrameRef = useRef<number | null>(null)
+
+  useLayoutEffect(() => () => {
+    if (pendingFrameRef.current === null) return
+    cancelAnimationFrame(pendingFrameRef.current)
+    pendingFrameRef.current = null
+  }, [])
+
+  return useCallback(() => {
+    if (pendingFrameRef.current !== null) return
+    let remainingFrames = INTERVAL_FRAMES
+    const advance = (): void => {
+      remainingFrames -= 1
+      if (remainingFrames > 0) {
+        pendingFrameRef.current = requestAnimationFrame(advance)
+        return
+      }
+      pendingFrameRef.current = null
+      updateRef.current()
+    }
+    pendingFrameRef.current = requestAnimationFrame(advance)
+  }, [])
+}
