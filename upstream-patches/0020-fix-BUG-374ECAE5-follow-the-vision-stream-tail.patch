+  it('follows the newest streamed visual text and restores the final summary start', () => {
+    let nextFrame = 1
+    let frames = new Map<number, FrameRequestCallback>()
+    vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => {
+      const id = nextFrame++
+      frames.set(id, callback)
+      return id
+    })
+    vi.stubGlobal('cancelAnimationFrame', (id: number) => { frames.delete(id) })
+    const flushFrames = (count: number): void => {
+      for (let index = 0; index < count; index += 1) {
+        const callbacks = [...frames.values()]
+        frames = new Map()
+        for (const callback of callbacks) callback(index)
+      }
+    }
+
+    const view = render(<VisionInspectRow {...props({
+      ...running(),
+      progressText: '{"summary":"Initial visual observation\\nNewest visual tokens',
+    }, 'running')} />)
+    const summary = view.container.querySelector<HTMLElement>('[data-vision-summary]')
+    expect(summary?.textContent).toBe('Newest visual tokens')
+    expect(summary?.getAttribute('data-follow-end')).toBe('true')
+    Object.defineProperties(summary, {
+      scrollWidth: { configurable: true, value: 320 },
+      clientWidth: { configurable: true, value: 100 },
+    })
+
+    view.rerender(<VisionInspectRow {...props({
+      ...running(),
+      progressText: '{"summary":"Initial visual observation\\nNewest visual tokens keep arriving',
+    }, 'running')} />)
+    act(() => { flushFrames(3) })
+    expect(summary?.textContent).toBe('Newest visual tokens keep arriving')
+    expect(summary?.scrollLeft).toBe(220)
+
+    view.rerender(<VisionInspectRow {...props(settled({
+      content: [{ type: 'text', text: '{"summary":"Final summary starts here\\nAdditional detail"}' }],
+    }), 'settled')} />)
+    act(() => { flushFrames(3) })
+    expect(summary?.textContent).toBe('Final summary starts here')
+    expect(summary?.scrollLeft).toBe(0)
+    expect(summary?.hasAttribute('data-follow-end')).toBe(false)
+  })
